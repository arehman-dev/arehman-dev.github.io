---
import Navbar from '../components/Navbar.astro';
import WaybarHud from '../components/WaybarHud.astro';
import SocialDock from '../components/SocialDock.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const { 
  title = "Abdul Rehman (arehman-dev) - Python Developer", 
  description = "Abdul Rehman (arehman-dev) - Python developer & System Administrator focused on automation, secure infrastructure, APIs and clean script architectures.",
  keywords = "arehman-dev, Abdul Rehman, Python developer, system administrator, Linux, Python, C++, DevOps, automation"
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Abdul Rehman" />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://arehman-dev.github.io/portfolio/assets/images/og-image.jpg" />
    <meta property="og:site_name" content="arehman-dev Portfolio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://arehman-dev.github.io/portfolio/assets/images/og-image.jpg" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2301ac6a'><text x='2' y='20' font-size='20' font-family='monospace' font-weight='bold' fill='%2301ac6a'>%3E_</text></svg>" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Theme Inline Initialization (Anti-FOUC) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const theme = getThemePreference();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <div class="app-layout">
      <Navbar />
      <WaybarHud />
      <SocialDock />
      <CommandPalette />
      <main class="page-content" id="main-content">
        <slot />
      </main>
      <footer class="cockpit-footer" id="cockpit-footer">
        <div class="footer-cockpit-inner">
          <div class="footer-col-telemetry">
            <span class="footer-led" title="Node Online"></span>
            <span class="footer-node-tag">[NODE: ISB-PK • 33.68° N, 73.04° E]</span>
            <span class="footer-status-tag">SYSTEMS: 100% OPERATIONAL</span>
          </div>

          <div class="footer-col-copy">
            <span class="copy-text">© 2026 ABDUL REHMAN</span>
            <span class="copy-sep">•</span>
            <span class="copy-role">SYSTEMS &amp; AUTOMATION ENGINEER</span>
          </div>

          <div class="footer-col-links">
            <a href={`${base}projects/`} class="footer-quick-link">~/projects</a>
            <span class="link-sep">/</span>
            <a href={`${base}articles/`} class="footer-quick-link">~/articles</a>
            <span class="link-sep">/</span>
            <a href={`${base}certificates/`} class="footer-quick-link">~/certificates</a>
            <span class="link-sep">/</span>
            <a href={`${base}me/`} class="footer-personal-pill">
              <i class="fas fa-pen-nib" aria-hidden="true"></i>
              <span>/me ↗</span>
            </a>
          </div>
        </div>

        <!-- Cockpit Keyboard Shortcuts Strip -->
        <div class="footer-shortcuts-strip">
          <div class="footer-shortcuts-inner">
            <span class="shortcuts-lead"><i class="fas fa-terminal"></i> <span>SYS_SHORTCUTS:</span></span>
            
            <button type="button" class="footer-shortcut-btn" id="foot-cmd-trigger" title="Open Command Telemetry Palette (Ctrl+K or /)">
              <kbd class="f-kbd">Ctrl</kbd><span class="f-plus">+</span><kbd class="f-kbd">K</kbd>
              <span class="f-action">Command Palette</span>
            </button>

            <span class="f-sep">&bull;</span>

            <button type="button" class="footer-shortcut-btn" id="foot-find-trigger" title="Instant Search Runbook (/)">
              <kbd class="f-kbd">/</kbd>
              <span class="f-action">Quick Search</span>
            </button>

            <span class="f-sep">&bull;</span>

            <button type="button" class="footer-shortcut-btn" id="foot-theme-trigger" title="Toggle Display Theme (T)">
              <kbd class="f-kbd">T</kbd>
              <span class="f-action">Toggle Theme</span>
            </button>

            <span class="f-sep">&bull;</span>

            <a href="https://github.com/arehman-dev/arehman-dev.github.io" target="_blank" rel="noopener noreferrer" class="footer-shortcut-btn" title="Inspect Astro Source Repository (G)">
              <kbd class="f-kbd">G</kbd>
              <span class="f-action">GitHub Source ↗</span>
            </a>

            <span class="f-sep">&bull;</span>

            <span class="footer-shortcut-btn hint-only" title="Press ESC to close open modals">
              <kbd class="f-kbd">ESC</kbd>
              <span class="f-action">Close Modal</span>
            </span>
          </div>
        </div>
      </footer>

      <!-- Footer Shortcuts Script -->
      <script is:inline>
        function setupFooterShortcuts() {
          const footCmdBtn = document.getElementById('foot-cmd-trigger');
          const footFindBtn = document.getElementById('foot-find-trigger');
          const footThemeBtn = document.getElementById('foot-theme-trigger');

          const openPaletteModal = () => {
            const input = document.getElementById('cmd-palette-input');
            const backdrop = document.getElementById('cmd-palette-backdrop');
            if (backdrop && input) {
              backdrop.classList.add('active');
              backdrop.setAttribute('aria-hidden', 'false');
              document.body.style.overflow = 'hidden';
              setTimeout(() => input.focus(), 50);
            }
          };

          if (footCmdBtn) footCmdBtn.addEventListener('click', openPaletteModal);
          if (footFindBtn) footFindBtn.addEventListener('click', openPaletteModal);

          if (footThemeBtn) {
            footThemeBtn.addEventListener('click', () => {
              const root = document.documentElement;
              const current = root.getAttribute('data-theme') || 'dark';
              const next = current === 'dark' ? 'light' : 'dark';
              root.setAttribute('data-theme', next);
              localStorage.setItem('theme', next);
            });
          }

          // Global single-key shortcuts: 't' to toggle theme, 'g' to open github (when not in an input/textarea)
          window.addEventListener('keydown', (e) => {
            const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
            const isEditable = document.activeElement ? document.activeElement.isContentEditable : false;
            if (activeTag === 'input' || activeTag === 'textarea' || isEditable) return;
            if (e.ctrlKey || e.metaKey || e.altKey) return;

            if (e.key.toLowerCase() === 't') {
              e.preventDefault();
              const root = document.documentElement;
              const current = root.getAttribute('data-theme') || 'dark';
              const next = current === 'dark' ? 'light' : 'dark';
              root.setAttribute('data-theme', next);
              localStorage.setItem('theme', next);
            } else if (e.key.toLowerCase() === 'g') {
              e.preventDefault();
              window.open('https://github.com/arehman-dev/arehman-dev.github.io', '_blank', 'noopener,noreferrer');
            }
          });
        }

        setupFooterShortcuts();
        document.addEventListener('astro:page-load', setupFooterShortcuts);
      </script>
    </div>
  </body>
</html>
