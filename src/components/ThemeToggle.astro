---
<button class="theme-toggle" id="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle light / dark display theme">
  <i class="fas fa-sun sun-icon" aria-hidden="true"></i>
  <i class="fas fa-moon moon-icon" aria-hidden="true"></i>
</button>

<style>
  .theme-toggle {
    background: transparent;
    border: 1px solid rgba(1, 172, 106, 0.25);
    border-radius: 6px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    color: var(--text-main);
  }

  .theme-toggle:hover {
    border-color: var(--primary, #01ac6a);
    background: rgba(1, 172, 106, 0.08);
    transform: translateY(-1px);
  }

  .sun-icon {
    display: none;
    color: #fbbf24;
  }

  .moon-icon {
    display: block;
    color: #4b5563;
  }

  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }

  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }
</style>

<script>
  function setupThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    const newToggle = toggleBtn.cloneNode(true) as HTMLElement;
    toggleBtn.parentNode?.replaceChild(newToggle, toggleBtn);

    newToggle.addEventListener('click', () => {
      const element = document.documentElement;
      const currentTheme = element.getAttribute('data-theme');
      const isDark = currentTheme === 'dark';
      const newTheme = isDark ? 'light' : 'dark';
      
      element.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
