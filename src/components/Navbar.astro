---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.endsWith('/') ? pathname : `${pathname}/`;

const navItems = [
  { label: 'Home', path: base },
  { label: 'About', path: `${base}about/` },
  { label: 'Projects', path: `${base}projects/` },
  { label: 'Certificates', path: `${base}certificates/` },
  { label: 'Skills & Exp', path: `${base}skills-experience/` },
  { label: 'Articles', path: `${base}articles/` },
  { label: 'Hire Me', path: `${base}hire-me/` }
];

const isActive = (path: string) => {
  if (path === base) {
    return currentPath === base || currentPath === `${base}index.html/` || currentPath === `${base}index.html`;
  }
  return currentPath === path || currentPath.startsWith(path);
};
---

<header class="navbar" id="navbar">
  <div class="nav-container">
    <a href={base} class="nav-logo">
      <span class="logo-term">&gt;_</span> Abdul Rehman
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-links-desktop">
      <ul>
        {navItems.map((item) => (
          <li>
            <a 
              href={item.path} 
              class={`nav-link ${isActive(item.path) ? 'active' : ''}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <a href={`${base}me/`} class="personal-space-pill" aria-label="Personal Space">
        <i class="fas fa-pen"></i> <span>/me</span>
      </a>
      <ThemeToggle />
      
      <!-- Hamburger Toggle for Mobile -->
      <button class="nav-mobile-toggle" id="nav-mobile-toggle" aria-label="Toggle navigation menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <nav class="nav-mobile-dropdown" id="nav-mobile-dropdown">
    <ul>
      {navItems.map((item) => (
        <li>
          <a 
            href={item.path} 
            class={`mobile-nav-link ${isActive(item.path) ? 'active' : ''}`}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href={`${base}me/`} class="mobile-nav-link">
          <i class="fas fa-pen"></i> Personal Space
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 58px;
    background-color: var(--glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--glass-border);
    z-index: 1000;
    transition: all 0.3s ease;
  }

  .nav-container {
    max-width: 1200px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    letter-spacing: -0.01em;
    background: linear-gradient(135deg, var(--green-500) 0%, var(--blue-500) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: transform var(--transition-speed);
  }

  .nav-logo:hover {
    transform: scale(1.02);
  }

  .logo-term {
    font-family: var(--font-mono);
    -webkit-text-fill-color: var(--primary);
  }

  /* Desktop links styling */
  .nav-links-desktop {
    display: block;
  }

  .nav-links-desktop ul {
    display: flex;
    list-style: none;
    gap: 0.5rem;
  }

  .nav-link {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.92rem;
    padding: 0.5rem 0.88rem;
    border-radius: 6px;
    transition: all 0.2s ease;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    color: var(--primary);
    background-color: var(--primary-light);
  }

  :global([data-theme="dark"]) .nav-link:hover {
    background-color: rgba(1, 172, 106, 0.08);
  }

  .nav-link.active {
    color: var(--primary);
    background-color: var(--primary-light);
    font-weight: 600;
  }

  :global([data-theme="dark"]) .nav-link.active {
    background-color: rgba(1, 172, 106, 0.12);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .personal-space-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.38rem 0.78rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: transparent;
    color: var(--text-main);
    transition: all 0.22s ease;
  }

  .personal-space-pill i {
    font-size: 0.76rem;
    color: var(--primary);
    transition: transform 0.22s ease, color 0.22s ease;
  }

  .personal-space-pill:hover {
    background-color: var(--primary-light);
    color: var(--primary);
    border-color: var(--primary);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(1, 172, 106, 0.12);
  }

  .personal-space-pill:hover i {
    transform: rotate(-8deg) scale(1.08);
  }

  :global([data-theme="dark"]) .personal-space-pill {
    background-color: rgba(255, 255, 255, 0.02);
    border-color: var(--border-color);
    color: var(--text-main);
  }

  :global([data-theme="dark"]) .personal-space-pill:hover {
    background-color: rgba(1, 172, 106, 0.12);
    color: var(--primary);
    border-color: var(--primary);
    box-shadow: 0 4px 14px rgba(1, 172, 106, 0.2);
  }

  /* Mobile Toggle button */
  .nav-mobile-toggle {
    display: none;
    background: transparent;
    border: 1px solid rgba(1, 172, 106, 0.25);
    border-radius: 6px;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    padding: 6px;
    transition: all 0.2s ease;
  }

  .nav-mobile-toggle:hover {
    border-color: var(--primary, #01ac6a);
    background: rgba(1, 172, 106, 0.08);
  }

  .bar {
    width: 18px;
    height: 2px;
    background-color: var(--text-main);
    transition: all 0.25s ease;
    border-radius: 2px;
  }

  /* Mobile Dropdown styling - clean drawer below navbar + waybar */
  .nav-mobile-dropdown {
    display: none;
    position: fixed;
    top: 90px;
    left: 0;
    right: 0;
    width: 100%;
    background-color: rgba(10, 10, 10, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(1, 172, 106, 0.25);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.6);
    padding: 1.25rem 1.5rem;
    z-index: 998;
    transform: translateY(-10px);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
    pointer-events: none;
    max-height: calc(100vh - 90px);
    overflow-y: auto;
  }

  [data-theme="light"] .nav-mobile-dropdown {
    background-color: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .nav-mobile-dropdown.active {
    display: block;
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .nav-mobile-dropdown ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    color: var(--text-main);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    color: var(--primary, #01ac6a);
    background-color: rgba(1, 172, 106, 0.1);
    border-color: rgba(1, 172, 106, 0.25);
  }

  /* Responsive styling */
  @media (min-width: 1024px) and (max-width: 1200px) {
    .nav-links-desktop ul {
      gap: 0.25rem;
    }
    .nav-link {
      padding: 0.45rem 0.65rem;
      font-size: 0.84rem;
    }
    .personal-space-pill {
      padding: 0.35rem 0.6rem;
      font-size: 0.76rem;
    }
  }

  @media (max-width: 1023px) {
    .nav-links-desktop {
      display: none;
    }

    .nav-mobile-toggle {
      display: flex;
    }

    /* Transform hamburger to an X on active */
    .nav-mobile-toggle.active .bar:nth-child(1) {
      transform: rotate(45deg) translate(4px, 4px);
    }
    .nav-mobile-toggle.active .bar:nth-child(2) {
      opacity: 0;
    }
    .nav-mobile-toggle.active .bar:nth-child(3) {
      transform: rotate(-45deg) translate(4px, -4px);
    }
  }
</style>

<script>
  function setupNavbar() {
    const toggleBtn = document.getElementById('nav-mobile-toggle');
    const dropdown = document.getElementById('nav-mobile-dropdown');

    if (!toggleBtn || !dropdown) return;

    // Remove existing event listener if any to prevent duplicate calls
    const newToggle = toggleBtn.cloneNode(true);
    toggleBtn.parentNode?.replaceChild(newToggle, toggleBtn);

    const toggleDropdown = (e: Event) => {
      e.stopPropagation();
      dropdown.classList.toggle('active');
      newToggle.classList.toggle('active');
    };

    const closeDropdown = () => {
      dropdown.classList.remove('active');
      newToggle.classList.remove('active');
    };

    newToggle.addEventListener('click', toggleDropdown);

    // Close when clicking links
    dropdown.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeDropdown);
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !newToggle.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    // Close on desktop resize
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        closeDropdown();
      }
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
