---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.endsWith('/') ? pathname : `${pathname}/`;

const navItems = [
  { label: 'Home', path: base },
  { label: 'About', path: `${base}about/` },
  { label: 'Projects', path: `${base}projects/` },
  { label: 'Certificates', path: `${base}certificates/` },
  { label: 'Skills & Exp', path: `${base}skills-experience/` },
  { label: 'Articles', path: `${base}articles/` },
  { label: 'Hire Me', path: `${base}hire-me/` }
];

const isActive = (path: string) => {
  if (path === base) {
    return currentPath === base || currentPath === `${base}index.html/` || currentPath === `${base}index.html`;
  }
  return currentPath === path || currentPath.startsWith(path);
};
---

<header class="navbar" id="navbar">
  <div class="nav-container">
    <a href={base} class="nav-logo" aria-label="Abdul Rehman Systems Engineering">
      <span class="logo-term">&gt;_</span>
      <span class="logo-name">abdulrehman</span>
      <span class="logo-node">[SYS]</span>
      <span class="logo-led" title="Kernel Active"></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-links-desktop" aria-label="Primary Telemetry Navigation">
      <ul>
        {navItems.map((item, idx) => (
          <li>
            <a 
              href={item.path} 
              class={`nav-link ${isActive(item.path) ? 'active' : ''}`}
            >
              <span class="nav-idx">0{idx + 1}</span>
              <span class="nav-label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <!-- Search & Command Palette Trigger Button -->
      <button class="nav-cmd-trigger" id="nav-cmd-trigger" title="Search & Commands (Press / or Ctrl+K)" aria-label="Open Search & Command Palette">
        <span class="cmd-symbol">⌘</span>
      </button>

      <a href={`${base}me/`} class="cockpit-personal-pill" aria-label="Switch to Creative & Personal Space">
        <i class="fas fa-pen-nib"></i>
        <span>/me ↗</span>
      </a>
      <ThemeToggle />
      
      <!-- Hamburger Toggle for Mobile -->
      <button class="nav-mobile-toggle" id="nav-mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <nav class="nav-mobile-dropdown" id="nav-mobile-dropdown" aria-label="Mobile Navigation">
    <div class="m-dropdown-caliper">
      <span class="m-caliper-text">[SYS-NAV // RUNBOOK ROUTING]</span>
    </div>
    <ul>
      {navItems.map((item, idx) => (
        <li>
          <a 
            href={item.path} 
            class={`mobile-nav-link ${isActive(item.path) ? 'active' : ''}`}
          >
            <span class="m-nav-idx">0{idx + 1} //</span>
            <span class="m-nav-label">{item.label}</span>
            {isActive(item.path) && <span class="m-active-dot"></span>}
          </a>
        </li>
      ))}
      <li class="m-personal-divider">
        <a href={`${base}me/`} class="mobile-nav-link m-personal-link">
          <i class="fas fa-pen-nib text-amber"></i>
          <span>/me &mdash; Creative Personal Space ↗</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 58px;
    background-color: rgba(8, 9, 11, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(1, 172, 106, 0.22);
    z-index: 1000;
    transition: background-color var(--transition-speed), border-color var(--transition-speed);
  }

  :global([data-theme="light"]) .navbar {
    background-color: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid rgba(1, 172, 106, 0.25);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.04);
  }

  .nav-container {
    max-width: 1200px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Cockpit Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.95rem;
    font-weight: 700;
    color: #f3f4f6;
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: transform 0.2s ease;
  }

  :global([data-theme="light"]) .nav-logo {
    color: #0f172a;
  }

  .nav-logo:hover {
    transform: translateY(-1px);
  }

  .logo-term {
    color: var(--primary, #01ac6a);
    font-weight: 800;
  }

  .logo-name {
    letter-spacing: -0.02em;
  }

  .logo-node {
    font-size: 0.65rem;
    font-weight: 700;
    color: #6b7280;
    letter-spacing: 0.05em;
  }

  :global([data-theme="light"]) .logo-node {
    color: #64748b;
  }

  .logo-led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary, #01ac6a);
    box-shadow: 0 0 6px var(--primary, #01ac6a);
    flex-shrink: 0;
    animation: ledPulse 2s infinite ease-in-out;
  }

  @keyframes ledPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.9); }
  }

  /* Desktop Navigation */
  .nav-links-desktop {
    display: block;
  }

  .nav-links-desktop ul {
    display: flex;
    list-style: none;
    gap: 0.35rem;
    align-items: center;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.76rem;
    font-weight: 600;
    color: #9ca3af;
    padding: 0.38rem 0.68rem;
    border-radius: 4px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  :global([data-theme="light"]) .nav-link {
    color: #4b5563;
  }

  .nav-idx {
    font-size: 0.62rem;
    color: #6b7280;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  :global([data-theme="light"]) .nav-idx {
    color: #94a3b8;
  }

  .nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-1px);
  }

  :global([data-theme="light"]) .nav-link:hover {
    color: #0f172a;
    background-color: rgba(1, 172, 106, 0.06);
    border-color: rgba(1, 172, 106, 0.25);
  }

  .nav-link:hover .nav-idx {
    color: var(--primary, #01ac6a);
  }

  .nav-link.active {
    color: var(--primary, #01ac6a);
    background-color: rgba(1, 172, 106, 0.12);
    border-color: rgba(1, 172, 106, 0.38);
    box-shadow: 0 0 10px rgba(1, 172, 106, 0.12);
  }

  :global([data-theme="light"]) .nav-link.active {
    color: #017a4b;
    background-color: rgba(1, 172, 106, 0.12);
    border-color: rgba(1, 172, 106, 0.45);
    font-weight: 700;
  }

  .nav-link.active .nav-idx {
    color: var(--primary, #01ac6a);
  }

  :global([data-theme="light"]) .nav-link.active .nav-idx {
    color: #017a4b;
  }

  /* Actions Area */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .nav-cmd-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(1, 172, 106, 0.25);
    border-radius: 4px;
    padding: 0.32rem 0.65rem;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.72rem;
    color: #9ca3af;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  :global([data-theme="light"]) .nav-cmd-trigger {
    background: transparent;
    border: 1px solid rgba(1, 172, 106, 0.3);
    color: #4b5563;
  }

  .nav-cmd-trigger:hover {
    color: var(--primary, #01ac6a);
    border-color: var(--primary, #01ac6a);
    background: rgba(1, 172, 106, 0.12);
    transform: translateY(-1px);
    box-shadow: 0 0 10px rgba(1, 172, 106, 0.2);
  }

  .cmd-symbol {
    font-size: 0.82rem;
    line-height: 1;
    color: var(--primary, #01ac6a);
  }

  :global([data-theme="light"]) .cmd-symbol {
    color: #017a4b;
  }

  :global([data-theme="light"]) .nav-cmd-trigger:hover {
    color: #017a4b;
    background: rgba(1, 172, 106, 0.08);
  }

  .cockpit-personal-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.32rem 0.65rem;
    border-radius: 4px;
    text-decoration: none;
    background: transparent;
    border: 1px solid rgba(1, 172, 106, 0.25);
    color: #9ca3af;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.18s ease;
  }

  :global([data-theme="light"]) .cockpit-personal-pill {
    background: transparent;
    border: 1px solid rgba(1, 172, 106, 0.3);
    color: #4b5563;
  }

  .cockpit-personal-pill:hover {
    background: rgba(1, 172, 106, 0.12);
    color: var(--primary, #01ac6a);
    border-color: var(--primary, #01ac6a);
    transform: translateY(-1px);
    box-shadow: 0 0 10px rgba(1, 172, 106, 0.25);
  }

  :global([data-theme="light"]) .cockpit-personal-pill:hover {
    background: rgba(1, 172, 106, 0.1);
    color: #017a4b;
    border-color: #01ac6a;
  }

  .cockpit-personal-pill i {
    font-size: 0.7rem;
    transition: transform 0.2s ease;
  }

  .cockpit-personal-pill:hover i {
    transform: rotate(-10deg) scale(1.1);
  }

  /* Mobile Toggle button */
  .nav-mobile-toggle {
    display: none;
    background: transparent;
    border: 1px solid rgba(1, 172, 106, 0.28);
    border-radius: 4px;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 34px;
    height: 34px;
    padding: 6px;
    transition: all 0.2s ease;
  }

  :global([data-theme="light"]) .nav-mobile-toggle {
    border-color: rgba(1, 172, 106, 0.35);
    background: #ffffff;
  }

  .nav-mobile-toggle:hover {
    border-color: var(--primary, #01ac6a);
    background: rgba(1, 172, 106, 0.1);
  }

  .bar {
    width: 17px;
    height: 2px;
    background-color: var(--text-main);
    transition: all 0.25s ease;
    border-radius: 1px;
  }

  /* Mobile Dropdown styling - clean telemetry drawer */
  .nav-mobile-dropdown {
    display: none;
    position: fixed;
    top: 90px;
    left: 0;
    right: 0;
    width: 100%;
    background-color: rgba(8, 9, 11, 0.98);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(1, 172, 106, 0.3);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.7);
    padding: 1.25rem 1.5rem;
    z-index: 998;
    transform: translateY(-8px);
    opacity: 0;
    transition: transform 0.22s ease, opacity 0.22s ease;
    pointer-events: none;
    max-height: calc(100vh - 90px);
    overflow-y: auto;
  }

  :global([data-theme="light"]) .nav-mobile-dropdown {
    background-color: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid rgba(1, 172, 106, 0.35);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .nav-mobile-dropdown.active {
    display: block;
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .m-dropdown-caliper {
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="light"]) .m-dropdown-caliper {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .m-caliper-text {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--primary, #01ac6a);
  }

  .nav-mobile-dropdown ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0.65rem 0.9rem;
    border-radius: 4px;
    color: #d1d5db;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  :global([data-theme="light"]) .mobile-nav-link {
    color: #374151;
  }

  .m-nav-idx {
    font-size: 0.7rem;
    color: #6b7280;
    letter-spacing: 0.03em;
  }

  :global([data-theme="light"]) .m-nav-idx {
    color: #94a3b8;
  }

  .m-nav-label {
    flex-grow: 1;
  }

  .m-active-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary, #01ac6a);
    box-shadow: 0 0 6px var(--primary, #01ac6a);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    color: var(--primary, #01ac6a);
    background-color: rgba(1, 172, 106, 0.1);
    border-color: rgba(1, 172, 106, 0.3);
  }

  :global([data-theme="light"]) .mobile-nav-link.active {
    color: #017a4b;
    background-color: rgba(1, 172, 106, 0.12);
    border-color: rgba(1, 172, 106, 0.35);
  }

  .m-personal-divider {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="light"]) .m-personal-divider {
    border-top: 1px dashed rgba(0, 0, 0, 0.1);
  }

  .m-personal-link {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.08);
    border-color: rgba(251, 191, 36, 0.25);
  }

  :global([data-theme="light"]) .m-personal-link {
    color: #92400e;
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .text-amber {
    color: #f59e0b;
  }

  /* Responsive styling */
  @media (min-width: 1024px) and (max-width: 1200px) {
    .nav-links-desktop ul {
      gap: 0.15rem;
    }
    .nav-link {
      padding: 0.35rem 0.5rem;
      font-size: 0.72rem;
    }
    .cockpit-personal-pill {
      padding: 0.3rem 0.5rem;
      font-size: 0.7rem;
    }
  }

  @media (max-width: 1023px) {
    .nav-links-desktop {
      display: none;
    }

    .nav-mobile-toggle {
      display: flex;
    }

    /* Transform hamburger to an X on active */
    .nav-mobile-toggle.active .bar:nth-child(1) {
      transform: rotate(45deg) translate(4px, 4px);
    }
    .nav-mobile-toggle.active .bar:nth-child(2) {
      opacity: 0;
    }
    .nav-mobile-toggle.active .bar:nth-child(3) {
      transform: rotate(-45deg) translate(4px, -4px);
    }
  }
</style>

<script>
  function setupNavbar() {
    const toggleBtn = document.getElementById('nav-mobile-toggle');
    const dropdown = document.getElementById('nav-mobile-dropdown');

    if (!toggleBtn || !dropdown) return;

    // Remove existing event listener if any to prevent duplicate calls
    const newToggle = toggleBtn.cloneNode(true) as HTMLElement;
    toggleBtn.parentNode?.replaceChild(newToggle, toggleBtn);

    const toggleDropdown = (e: Event) => {
      e.stopPropagation();
      const isActive = dropdown.classList.toggle('active');
      newToggle.classList.toggle('active');
      newToggle.setAttribute('aria-expanded', isActive ? 'true' : 'false');
    };

    const closeDropdown = () => {
      dropdown.classList.remove('active');
      newToggle.classList.remove('active');
      newToggle.setAttribute('aria-expanded', 'false');
    };

    newToggle.addEventListener('click', toggleDropdown);

    // Close when clicking links
    dropdown.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeDropdown);
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !newToggle.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    // Close on desktop resize
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        closeDropdown();
      }
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>