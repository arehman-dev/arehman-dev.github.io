---
<aside class="social-bar" id="social-bar" aria-label="Social & Direct Channels">
  <!-- Telemetry Header -->
  <div class="dock-header" title="I/O Direct Communication Channels Active">
    <span class="dock-led"></span>
    <span class="dock-tag">I/O</span>
  </div>

  <div class="dock-sep" aria-hidden="true"></div>

  <!-- Channel Links -->
  <div class="dock-links">
    <a href="https://github.com/arehman-dev" aria-label="GitHub profile" target="_blank" rel="noopener" class="social-link github">
      <i class="fab fa-github" aria-hidden="true"></i>
      <span class="social-tooltip" role="tooltip">gh/arehman-dev ↗</span>
    </a>
    <a href="https://linkedin.com/in/arehman-dev" aria-label="LinkedIn profile" target="_blank" rel="noopener" class="social-link linkedin">
      <i class="fab fa-linkedin" aria-hidden="true"></i>
      <span class="social-tooltip" role="tooltip">in/arehman-dev ↗</span>
    </a>
    <a href="https://twitter.com/arehman_dev" aria-label="X Twitter profile" target="_blank" rel="noopener" class="social-link x-twitter">
      <i class="fab fa-x-twitter" aria-hidden="true"></i>
      <span class="social-tooltip" role="tooltip">x/arehman_dev ↗</span>
    </a>
    <a href="mailto:arehman.dev@proton.me" aria-label="Direct Email" class="social-link email">
      <i class="fas fa-envelope" aria-hidden="true"></i>
      <span class="social-tooltip" role="tooltip">mailto:proton.me ↗</span>
    </a>
  </div>
</aside>

<style>
  /* ==========================================================================
     UNIFIED SYSTEM I/O DOCK CAPSULE
     ========================================================================== */
  .social-bar {
    position: fixed;
    bottom: 2.25rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 4px;
    background: rgba(10, 14, 18, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(1, 172, 106, 0.22);
    border-radius: 8px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45), 0 0 1px rgba(1, 172, 106, 0.2);
    z-index: 100;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
  }

  .social-bar:hover {
    border-color: rgba(1, 172, 106, 0.4);
  }

  :global([data-theme="light"]) .social-bar {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(1, 172, 106, 0.30);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
  }

  :global([data-theme="light"]) .social-bar:hover {
    border-color: rgba(1, 172, 106, 0.55);
  }

  .social-bar.docked-hidden {
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
  }

  /* Dock Telemetry Header */
  .dock-header {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 2px 4px 4px;
    user-select: none;
    cursor: default;
  }

  .dock-led {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--primary, #01ac6a);
    box-shadow: 0 0 6px var(--primary, #01ac6a);
    animation: dockLedPulse 2.4s infinite ease-in-out;
  }

  @keyframes dockLedPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .dock-tag {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #6b7280;
    line-height: 1;
  }

  :global([data-theme="light"]) .dock-tag {
    color: #4b5563;
  }

  /* Hairline Separator */
  .dock-sep {
    width: 20px;
    height: 1px;
    background: rgba(1, 172, 106, 0.18);
    margin: 2px 0 4px;
  }

  :global([data-theme="light"]) .dock-sep {
    background: rgba(1, 172, 106, 0.25);
  }

  /* Links Cluster */
  .dock-links {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .social-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 5px;
    color: #9ca3af;
    background: transparent;
    text-decoration: none;
    font-size: 0.98rem;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global([data-theme="light"]) .social-link {
    color: #4b5563;
  }

  .social-link i {
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Cockpit Hover State: Horizontal Inward Glide & Phosphor Accent */
  .social-link:hover {
    background: rgba(1, 172, 106, 0.12);
    color: #00c47a;
  }

  .social-link:hover i {
    transform: translateX(-1.5px);
  }

  :global([data-theme="light"]) .social-link:hover {
    background: rgba(1, 172, 106, 0.14);
    color: #017a4b;
  }

  /* ==========================================================================
     MONOSPACE FLYOUT TOOLTIPS (INWARD TO THE LEFT)
     ========================================================================== */
  .social-tooltip {
    position: absolute;
    right: calc(100% + 10px);
    left: auto;
    top: 50%;
    transform: translateY(-50%) translateX(4px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    white-space: nowrap;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(10, 14, 18, 0.96);
    border: 1px solid rgba(1, 172, 106, 0.35);
    color: #00e58e;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    transition: opacity 0.16s ease, transform 0.16s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.16s;
    z-index: 101;
  }

  /* Micro Arrow Indicator (Pointing Right toward Icon) */
  .social-tooltip::before {
    content: "";
    position: absolute;
    left: 100%;
    right: auto;
    top: 50%;
    transform: translateY(-50%);
    border-width: 4px 0 4px 5px;
    border-style: solid;
    border-color: transparent transparent transparent rgba(1, 172, 106, 0.35);
  }

  :global([data-theme="light"]) .social-tooltip {
    background: #ffffff;
    border: 1px solid rgba(1, 172, 106, 0.45);
    color: #017a4b;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  :global([data-theme="light"]) .social-tooltip::before {
    border-color: transparent transparent transparent rgba(1, 172, 106, 0.45);
  }

  .social-link:hover .social-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%) translateX(0);
  }

  /* Hide on screens below 1024px to prevent content collisions */
  @media (max-width: 1023px) {
    .social-bar {
      display: none;
    }
  }
</style>

<script>
  function setupSocialDock() {
    const socialBar = document.getElementById('social-bar');
    const footer = document.getElementById('cockpit-footer');
    if (!socialBar || !footer) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            socialBar.classList.add('docked-hidden');
          } else {
            socialBar.classList.remove('docked-hidden');
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(footer);
  }

  setupSocialDock();
  document.addEventListener('astro:page-load', setupSocialDock);
</script>
