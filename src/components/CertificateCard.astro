---
import type { Certificate } from '../data/certificates';

interface Props {
  certificate: Certificate;
}

const { certificate } = Astro.props;
const statusClass = `badge-${certificate.status.toLowerCase().replace(/\s+/g, '-')}`;
---

<article class="certificate-card card">
  <div class="card-icon-container">
    <i class="fas fa-award cert-icon"></i>
  </div>
  
  <div class="card-content">
    <div class="card-header-row">
      <span class={`badge ${statusClass}`}>{certificate.status}</span>
      <span class="cert-date">{certificate.date}</span>
    </div>
    
    <h3 class="cert-title">{certificate.title}</h3>
    <p class="cert-issuer"><i class="far fa-building"></i> {certificate.issuer}</p>
    <p class="cert-description">{certificate.description}</p>
    
    <div class="card-footer mt-lg">
      <a href={`${import.meta.env.BASE_URL}certificates/${certificate.slug}`} class="btn btn-outline btn-sm">
        <i class="fas fa-info-circle"></i> View Details
      </a>
    </div>
  </div>
</article>

<style>
  .certificate-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .card-icon-container {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    background-color: var(--primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  [data-theme="dark"] .card-icon-container {
    background-color: rgba(1, 172, 106, 0.1);
  }

  .cert-icon {
    font-size: 1.75rem;
    color: var(--primary);
  }

  .certificate-card:hover .card-icon-container {
    transform: rotate(10deg) scale(1.1);
    background-color: var(--primary);
  }

  .certificate-card:hover .cert-icon {
    color: var(--white);
  }

  .card-content {
    flex-grow: 1;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cert-date {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .cert-title {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .cert-issuer {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--secondary);
    margin-bottom: 0.75rem;
  }

  .cert-description {
    font-size: 0.88rem;
    margin-bottom: 0.5rem;
  }

  .btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
  }

  @media (max-width: 639px) {
    .certificate-card {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
