---
// ProcessTree.astro - Linux `btop`/`htop` Process Table for Skills & Competencies
---

<div class="proc-monitor-container" id="process-monitor">
  <div class="proc-header">
    <div class="proc-title-group">
      <span class="proc-badge"><i class="fas fa-microchip"></i> LIVE PROCESS TREE</span>
      <h3 class="proc-title">System Competencies &amp; Active Daemons</h3>
    </div>
    <div class="proc-meta">
      <span class="proc-stat">Tasks: <strong class="text-success">5 active</strong></span>
      <span class="proc-stat">Threads: <strong>32</strong></span>
      <span class="proc-stat">Load avg: <strong>0.12, 0.08, 0.04</strong></span>
    </div>
  </div>

  <div class="proc-table-wrapper">
    <table class="proc-table">
      <thead>
        <tr>
          <th class="col-pid">PID</th>
          <th class="col-cmd">SUBSYSTEM COMMAND</th>
          <th class="col-load">MASTERY / LOAD</th>
          <th class="col-details">CAPABILITIES &amp; RUNTIME LIBRARIES</th>
          <th class="col-status">STATE</th>
        </tr>
      </thead>
      <tbody>
        <!-- Process 1: Python Automation -->
        <tr class="proc-row" data-subsystem="automation">
          <td class="col-pid"><span class="pid-tag">101</span></td>
          <td class="col-cmd">
            <span class="cmd-icon python-icon"><i class="fab fa-python"></i></span>
            <span class="cmd-name">python-automation.daemon</span>
          </td>
          <td class="col-load">
            <div class="bar-container">
              <div class="bar-fill" style="width: 92%;"></div>
            </div>
            <span class="bar-val">92%</span>
          </td>
          <td class="col-details">
            <span class="chip">AsyncIO</span>
            <span class="chip">ETL Pipelines</span>
            <span class="chip">Cron Scheduling</span>
            <span class="chip">OCR &amp; PDF Ingestion</span>
            <span class="chip">API Integration</span>
          </td>
          <td class="col-status">
            <span class="status-chip status-running">RUNNING</span>
          </td>
        </tr>

        <!-- Process 2: C++ Systems Programming -->
        <tr class="proc-row" data-subsystem="cpp">
          <td class="col-pid"><span class="pid-tag">102</span></td>
          <td class="col-cmd">
            <span class="cmd-icon cpp-icon"><i class="fas fa-cubes"></i></span>
            <span class="cmd-name">cpp20-systems.worker</span>
          </td>
          <td class="col-load">
            <div class="bar-container">
              <div class="bar-fill" style="width: 80%;"></div>
            </div>
            <span class="bar-val">80%</span>
          </td>
          <td class="col-details">
            <span class="chip">POSIX Sockets</span>
            <span class="chip">Memory Arenas</span>
            <span class="chip">Multithreading</span>
            <span class="chip">GCC 13 / Clang</span>
            <span class="chip">GTK GUI Core</span>
          </td>
          <td class="col-status">
            <span class="status-chip status-running">ACTIVE</span>
          </td>
        </tr>

        <!-- Process 3: Linux Administration & Hardening -->
        <tr class="proc-row" data-subsystem="sysadmin">
          <td class="col-pid"><span class="pid-tag">103</span></td>
          <td class="col-cmd">
            <span class="cmd-icon linux-icon"><i class="fab fa-linux"></i></span>
            <span class="cmd-name">linux-sysadmin.service</span>
          </td>
          <td class="col-load">
            <div class="bar-container">
              <div class="bar-fill" style="width: 96%;"></div>
            </div>
            <span class="bar-val">96%</span>
          </td>
          <td class="col-details">
            <span class="chip">Debian / Ubuntu</span>
            <span class="chip">Systemd Units</span>
            <span class="chip">Bash Automations</span>
            <span class="chip">UFW Hardening</span>
            <span class="chip">SSH / Key Infrastructure</span>
          </td>
          <td class="col-status">
            <span class="status-chip status-resident">RESIDENT</span>
          </td>
        </tr>

        <!-- Process 4: Quality Assurance & Testing -->
        <tr class="proc-row" data-subsystem="qa">
          <td class="col-pid"><span class="pid-tag">104</span></td>
          <td class="col-cmd">
            <span class="cmd-icon test-icon"><i class="fas fa-vial"></i></span>
            <span class="cmd-name">qa-verification.runner</span>
          </td>
          <td class="col-load">
            <div class="bar-container">
              <div class="bar-fill" style="width: 85%;"></div>
            </div>
            <span class="bar-val">85%</span>
          </td>
          <td class="col-details">
            <span class="chip">Pytest Suite</span>
            <span class="chip">Mock Verification</span>
            <span class="chip">PEP 8 Strictness</span>
            <span class="chip">Regression Guards</span>
            <span class="chip">CI Quality Gates</span>
          </td>
          <td class="col-status">
            <span class="status-chip status-running">WATCHING</span>
          </td>
        </tr>

        <!-- Process 5: Relational Data & Schema Management -->
        <tr class="proc-row" data-subsystem="database">
          <td class="col-pid"><span class="pid-tag">105</span></td>
          <td class="col-cmd">
            <span class="cmd-icon db-icon"><i class="fas fa-database"></i></span>
            <span class="cmd-name">relational-sql.storage</span>
          </td>
          <td class="col-load">
            <div class="bar-container">
              <div class="bar-fill" style="width: 82%;"></div>
            </div>
            <span class="bar-val">82%</span>
          </td>
          <td class="col-details">
            <span class="chip">SQLite / PostgreSQL</span>
            <span class="chip">Normalized Schemas</span>
            <span class="chip">Data Integrity</span>
            <span class="chip">Automated Backup Dumps</span>
          </td>
          <td class="col-status">
            <span class="status-chip status-idle">STANDBY</span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<style>
  .proc-monitor-container {
    background: #0d0f12;
    border: 1px solid rgba(1, 172, 106, 0.22);
    border-radius: 8px;
    padding: 1.25rem;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    margin: 2.5rem 0;
  }

  :global([data-theme="light"]) .proc-monitor-container {
    background: #ffffff;
    border: 1px solid rgba(1, 172, 106, 0.35);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .proc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
    gap: 1rem;
  }

  :global([data-theme="light"]) .proc-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .proc-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.68rem;
    color: var(--primary, #01ac6a);
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .proc-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f3f4f6;
    margin: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  :global([data-theme="light"]) .proc-title {
    color: #111827;
  }

  .proc-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: #9ca3af;
  }

  :global([data-theme="light"]) .proc-meta {
    color: #374151;
  }

  .proc-stat strong {
    color: #e5e7eb;
  }
  :global([data-theme="light"]) .proc-stat strong {
    color: #111827;
  }
  .text-success {
    color: var(--primary, #01ac6a) !important;
  }
  :global([data-theme="light"]) .text-success {
    color: #017a4b !important;
  }

  /* Table Layout */
  .proc-table-wrapper {
    overflow-x: auto;
  }

  .proc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    text-align: left;
  }

  .proc-table th {
    color: #6b7280;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 8px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="light"]) .proc-table th {
    border-bottom: 1px solid rgba(0, 0, 0, 0.09);
    color: #374151;
    font-weight: 700;
  }

  .proc-row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    border-left: 3px solid transparent;
    transition: background 0.15s ease, transform 0.15s ease, border-left-color 0.15s ease;
  }

  :global([data-theme="light"]) .proc-row {
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .proc-row:hover {
    background: rgba(1, 172, 106, 0.06);
    border-left-color: var(--primary, #01ac6a);
    transform: translateX(3px);
  }

  :global([data-theme="light"]) .proc-row:hover {
    background: rgba(1, 172, 106, 0.05);
    border-left-color: #01ac6a;
  }

  .proc-table td {
    padding: 10px 10px;
    vertical-align: middle;
  }

  .col-pid {
    width: 50px;
  }
  .pid-tag {
    color: #9ca3af;
    font-weight: 600;
    font-size: 0.75rem;
  }
  :global([data-theme="light"]) .pid-tag {
    color: #4b5563;
    font-weight: 700;
  }

  .col-cmd {
    font-weight: 600;
    white-space: nowrap;
  }
  .cmd-name {
    color: #f3f4f6;
  }
  :global([data-theme="light"]) .cmd-name {
    color: #111827;
  }

  .cmd-icon {
    display: inline-block;
    width: 18px;
    margin-right: 6px;
    text-align: center;
  }
  .python-icon { color: #f59e0b; }
  .cpp-icon { color: #3b82f6; }
  .linux-icon { color: #10b981; }
  .test-icon { color: #ec4899; }
  .db-icon { color: #8b5cf6; }

  /* Load Bar */
  .col-load {
    width: 160px;
  }
  .bar-container {
    width: 100px;
    height: 7px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
    display: inline-block;
    vertical-align: middle;
    margin-right: 8px;
  }
  :global([data-theme="light"]) .bar-container {
    background: rgba(0, 0, 0, 0.1);
  }

  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #01ac6a, #00c47a);
    border-radius: 3px;
  }

  .bar-val {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--primary, #01ac6a);
  }
  :global([data-theme="light"]) .bar-val {
    color: #017a4b;
    font-weight: 700;
  }

  /* Details & Chips */
  .col-details {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }

  .chip {
    display: inline-block;
    font-size: 0.68rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #d1d5db;
    padding: 2px 7px;
    border-radius: 4px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .chip:hover {
    border-color: rgba(1, 172, 106, 0.35);
  }

  :global([data-theme="light"]) .chip {
    background: #f3f4f6;
    border: 1px solid rgba(0, 0, 0, 0.1);
    color: #1f2937;
  }

  :global([data-theme="light"]) .chip:hover {
    border-color: #01ac6a;
    background: rgba(1, 172, 106, 0.06);
  }

  /* Status Chips */
  .col-status {
    width: 90px;
    text-align: right;
  }

  .status-chip {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 3px;
    letter-spacing: 0.04em;
  }

  .status-running {
    background: rgba(1, 172, 106, 0.15);
    color: var(--primary, #01ac6a);
    border: 1px solid rgba(1, 172, 106, 0.3);
  }
  :global([data-theme="light"]) .status-running {
    background: rgba(1, 172, 106, 0.12);
    color: #017a4b;
    border-color: rgba(1, 172, 106, 0.4);
  }

  .status-resident {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }
  :global([data-theme="light"]) .status-resident {
    background: rgba(37, 99, 235, 0.1);
    color: #1d4ed8;
    border-color: rgba(37, 99, 235, 0.35);
  }

  .status-idle {
    background: rgba(156, 163, 175, 0.15);
    color: #9ca3af;
    border: 1px solid rgba(156, 163, 175, 0.3);
  }
  :global([data-theme="light"]) .status-idle {
    background: rgba(107, 114, 128, 0.1);
    color: #374151;
    border-color: rgba(107, 114, 128, 0.3);
  }

  @media (max-width: 768px) {
    .col-status {
      display: none;
    }
    .col-load {
      width: 110px;
    }
    .bar-container {
      width: 60px;
    }
  }
</style>
