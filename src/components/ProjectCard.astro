---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Determine status badge class
const statusClass = `badge-${project.status.toLowerCase().replace(/\s+/g, '-')}`;

// Determine project icon based on title/tags
const getProjectIcon = (title: string, tags: string[]) => {
  const t = title.toLowerCase();
  if (t.includes('blue orbit') || tags.includes('Android')) return 'fa-mobile-screen-button';
  if (t.includes('ocr') || t.includes('arabic')) return 'fa-book-open';
  if (t.includes('virtual network') || tags.includes('ip netns')) return 'fa-network-wired';
  if (t.includes('prayer') || t.includes('notifier') || t.includes('gnome')) return 'fa-bell';
  if (t.includes('script') || tags.includes('Bash')) return 'fa-terminal';
  if (t.includes('portfolio') || t.includes('personal site') || t.includes('unified')) return 'fa-laptop-code';
  if (t.includes('server') || tags.includes('Linux') || tags.includes('Debian')) return 'fa-server';
  return 'fa-code';
};

const iconClass = getProjectIcon(project.title, project.tags);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<article class="project-card card">
  <div class="project-top-bar">
    <div class="project-icon-box">
      <i class={`fas ${iconClass} project-icon`}></i>
    </div>
    <div class="project-meta-right">
      <span class={`badge ${statusClass}`}>{project.status}</span>
    </div>
  </div>
  
  <div class="card-body">
    <h3 class="card-title">
      <a href={`${base}projects/${project.slug}/`} class="card-title-link">
        {project.title}
      </a>
    </h3>
    <p class="card-description">{project.description}</p>
    
    <div class="tech-stack flex flex-wrap">
      {project.tags.map(tag => (
        <span class="tech-tag">{tag}</span>
      ))}
    </div>
    
    <div class="card-footer">
      <a href={`${base}projects/${project.slug}/`} class="btn btn-primary btn-sm">
        <i class="fas fa-arrow-up-right-from-square"></i> View Details
      </a>
      {project.sourceLink && (
        <a href={project.sourceLink} class="btn btn-outline btn-sm" target="_blank" rel="noopener">
          <i class="fab fa-github"></i> Code
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.6rem 1.65rem;
    border-top: 3px solid var(--primary);
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-card:hover {
    border-top-color: var(--secondary);
  }

  .project-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .project-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(1, 172, 106, 0.12) 0%, rgba(57, 123, 201, 0.12) 100%);
    border: 1px solid rgba(1, 172, 106, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.35s ease;
  }

  :global([data-theme="dark"]) .project-icon-box {
    background: linear-gradient(135deg, rgba(1, 172, 106, 0.16) 0%, rgba(57, 123, 201, 0.16) 100%);
    border-color: rgba(1, 172, 106, 0.32);
  }

  .project-icon {
    font-size: 1.35rem;
    color: var(--primary);
    transition: transform 0.35s ease, color 0.35s ease;
  }

  .project-card:hover .project-icon-box {
    background: linear-gradient(135deg, var(--green-500) 0%, var(--blue-500) 100%);
    border-color: transparent;
    transform: scale(1.08) rotate(-4deg);
    box-shadow: 0 6px 16px rgba(1, 172, 106, 0.28);
  }

  .project-card:hover .project-icon {
    color: var(--white);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-size: 1.25rem;
    margin-bottom: 0.55rem;
    line-height: 1.35;
  }

  .card-title-link {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title-link:hover {
    color: var(--primary);
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .tech-stack {
    gap: 0.45rem;
    margin-bottom: 1.35rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    background-color: var(--gray-100);
    color: var(--text-muted);
    padding: 0.22rem 0.58rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  :global([data-theme="dark"]) .tech-tag {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.09);
    color: #cbd5e1;
  }

  .project-card:hover .tech-tag {
    border-color: rgba(1, 172, 106, 0.28);
  }

  .card-footer {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-color);
    margin-top: auto;
  }

  .btn-sm {
    padding: 0.48rem 0.95rem;
    font-size: 0.83rem;
  }
</style>
