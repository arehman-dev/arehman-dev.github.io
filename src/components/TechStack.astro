---
import { techStackData } from '../data/skills';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`cockpit-toolbelt-box ${className}`.trim()} aria-labelledby="tech-stack-heading">
  <!-- Toolbelt Caliper Header -->
  <div class="toolbelt-head">
    <div class="toolbelt-title-block">
      <span class="toolbelt-caliper-tag">[SPEC-MATRIX: TOOLBELT &amp; RUNTIME COMPILERS]</span>
      <h3 id="tech-stack-heading" class="toolbelt-title">
        <i class="fas fa-layer-group text-primary"></i> Complete Tech Stack &amp; Toolbelt
      </h3>
      <p class="toolbelt-subtitle">
        Hardened runtimes, compiler toolchains, Linux utilities, network protocols, and infrastructure frameworks.
      </p>
    </div>

    <!-- Telemetry Legend -->
    <div class="toolbelt-legend" aria-label="Toolbelt proficiency legend">
      <span class="legend-chip legend-core">
        <span class="legend-indicator dot-core"></span>
        <span>CORE / DAILY DRIVER</span>
      </span>
      <span class="legend-chip legend-worked">
        <span class="legend-indicator dot-worked"></span>
        <span>DEPLOYED / WORKED WITH</span>
      </span>
    </div>
  </div>

  <!-- Chip Wall -->
  <div class="tech-chip-grid">
    {techStackData.map((tech) => (
      <div class={`tech-spec-chip ${tech.isCore ? 'chip-core' : 'chip-regular'}`}>
        <span class={`spec-dot ${tech.isCore ? 'dot-active' : 'dot-passive'}`}></span>
        <i class={`${tech.icon} chip-icon`} aria-hidden="true"></i>
        <span class="chip-name">{tech.name}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .cockpit-toolbelt-box {
    background: #080808;
    border: 1px solid rgba(1, 172, 106, 0.25);
    border-radius: 8px;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    margin: 1.5rem 0;
  }

  [data-theme="light"] .cockpit-toolbelt-box {
    background: #ffffff;
    border: 1px solid rgba(1, 172, 106, 0.35);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .toolbelt-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  [data-theme="light"] .toolbelt-head {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .toolbelt-caliper-tag {
    font-size: 0.68rem;
    color: var(--primary, #01ac6a);
    font-weight: 700;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .toolbelt-title {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #f3f4f6;
    margin: 0 0 0.4rem 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  [data-theme="light"] .toolbelt-title {
    color: #111827;
  }

  .toolbelt-subtitle {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.88rem;
    color: #9ca3af;
    margin: 0;
    line-height: 1.5;
  }

  [data-theme="light"] .toolbelt-subtitle {
    color: #4b5563;
  }

  /* Legend */
  .toolbelt-legend {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .legend-chip {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #9ca3af;
  }

  [data-theme="light"] .legend-chip {
    background: #f9fafb;
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #4b5563;
  }

  .legend-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-core {
    background: #01ac6a;
    box-shadow: 0 0 6px #01ac6a;
  }

  .dot-worked {
    border: 1.5px solid #9ca3af;
    background: transparent;
  }

  /* Grid of Chips */
  .tech-chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tech-spec-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.38rem 0.75rem;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 500;
    transition: all 0.15s ease;
    user-select: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    color: #d1d5db;
  }

  [data-theme="light"] .tech-spec-chip {
    background: #f9fafb;
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #1f2937;
  }

  .tech-spec-chip:hover {
    border-color: rgba(1, 172, 106, 0.5);
    background: rgba(1, 172, 106, 0.05);
    transform: translateY(-1px);
    color: #ffffff;
  }

  [data-theme="light"] .tech-spec-chip:hover {
    color: #017a4b;
    background: rgba(1, 172, 106, 0.08);
    border-color: #01ac6a;
  }

  .chip-core {
    border-color: rgba(1, 172, 106, 0.35);
    background: rgba(1, 172, 106, 0.08);
    color: #e5e7eb;
    font-weight: 600;
  }

  [data-theme="light"] .chip-core {
    background: rgba(1, 172, 106, 0.08);
    border-color: rgba(1, 172, 106, 0.4);
    color: #017a4b;
    font-weight: 700;
  }

  .spec-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-active {
    background: #01ac6a;
    box-shadow: 0 0 6px rgba(1, 172, 106, 0.8);
  }

  .dot-passive {
    background: #6b7280;
    opacity: 0.5;
  }

  .chip-icon {
    font-size: 0.85rem;
    color: var(--primary, #01ac6a);
  }

  .text-primary {
    color: var(--primary, #01ac6a);
  }
</style>
