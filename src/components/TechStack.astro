---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const corePillars = [
  {
    name: "Python & Automation",
    icon: "fab fa-python",
    color: "#f59e0b",
    tag: "Primary Language",
    description: "Multithreaded ingestion, AsyncIO daemons, FastAPI endpoints, web scraping, and automated workflows.",
    tools: ["Python 3.12", "FastAPI", "AsyncIO", "Requests", "BeautifulSoup4", "Pytest"]
  },
  {
    name: "Linux & DevOps",
    icon: "fab fa-linux",
    color: "#01ac6a",
    tag: "Native Platform",
    description: "System administration, systemd service units, POSIX shell automation, and Docker containerization.",
    tools: ["Debian / Ubuntu", "Bash", "Docker", "systemd", "WireGuard", "Git"]
  },
  {
    name: "Applied AI & Vision",
    icon: "fas fa-brain",
    color: "#38bdf8",
    tag: "AI & ML",
    description: "Multimodal OCR engines, document classification, LLM toolchains, and computer vision pipelines.",
    tools: ["OpenCV", "Tesseract / EasyOCR", "PyTorch", "NumPy", "Pandas", "Local LLMs"]
  },
  {
    name: "C++ & Systems",
    icon: "fas fa-code",
    color: "#a855f7",
    tag: "High Performance",
    description: "Memory layouts, compile-time optimization, deterministic algorithms, and low-level CLI utilities.",
    tools: ["Modern C++20", "STL", "CMake", "GCC / Clang", "GDB", "Valgrind"]
  },
  {
    name: "Data & Persistence",
    icon: "fas fa-database",
    color: "#14b8a6",
    tag: "Persistence & ETL",
    description: "Structured storage, Google Sheets API synchronization engines, ETL, and local-first SQLite.",
    tools: ["SQLite", "PostgreSQL", "Google Sheets API", "SQLAlchemy", "JSON Streams"]
  }
];
---

<div class={`developer-toolbelt-wrapper ${className}`.trim()} aria-labelledby="tech-stack-heading">
  <!-- 01: Core Pillars Showcase Grid -->
  <div class="pillars-grid">
    {corePillars.map((pillar) => (
      <div class="pillar-card">
        <div class="pillar-top">
          <div class="pillar-icon-wrap" style={`color: ${pillar.color}; border-color: ${pillar.color}33; background: ${pillar.color}12;`}>
            <i class={pillar.icon}></i>
          </div>
          <span class="pillar-tag">{pillar.tag}</span>
        </div>
        <h4 class="pillar-title">{pillar.name}</h4>
        <p class="pillar-desc">{pillar.description}</p>
        <div class="pillar-tools">
          {pillar.tools.map((t) => (
            <span class="pillar-tool-pill">{t}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- 02: Explore Full Toolchain & Experience CTA -->
  <div class="pillars-footer-action">
    <a href={`${base}skills-experience/`} class="toolbelt-explore-btn">
      <i class="fas fa-layer-group text-primary"></i>
      <span>Explore Full 40+ Toolchain Directory on Skills Page</span>
      <i class="fas fa-arrow-right"></i>
    </a>
  </div>
</div>

<style>
  .developer-toolbelt-wrapper {
    margin: 1.5rem 0 2.5rem 0;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  /* 01: Core Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .pillar-card {
    background: #0d0f12;
    border: 1px solid rgba(1, 172, 106, 0.22);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  :global([data-theme="light"]) .pillar-card {
    background: #ffffff;
    border: 1px solid rgba(1, 172, 106, 0.28);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .pillar-card:hover {
    transform: translateY(-2px);
    border-color: rgba(1, 172, 106, 0.45);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
  }

  :global([data-theme="light"]) .pillar-card:hover {
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  .pillar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .pillar-icon-wrap {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  .pillar-tag {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.64rem;
    font-weight: 700;
    color: #9ca3af;
    background: rgba(255, 255, 255, 0.04);
    padding: 2px 6px;
    border-radius: 3px;
    letter-spacing: 0.03em;
  }

  :global([data-theme="light"]) .pillar-tag {
    color: #4b5563;
    background: #f3f4f6;
  }

  .pillar-title {
    font-size: 1rem;
    font-weight: 700;
    color: #f3f4f6;
    margin: 0 0 0.4rem 0;
  }

  :global([data-theme="light"]) .pillar-title {
    color: #111827;
  }

  .pillar-desc {
    font-size: 0.78rem;
    color: #9ca3af;
    line-height: 1.45;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  :global([data-theme="light"]) .pillar-desc {
    color: #4b5563;
  }

  .pillar-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .pillar-tool-pill {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.65rem;
    color: #d1d5db;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 3px;
  }

  :global([data-theme="light"]) .pillar-tool-pill {
    color: #374151;
    background: #f8fafc;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  /* 02: Pillars Footer Action */
  .pillars-footer-action {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .toolbelt-explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0.75rem 1.6rem;
    background: rgba(1, 172, 106, 0.08);
    border: 1px solid rgba(1, 172, 106, 0.32);
    border-radius: 6px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.82rem;
    font-weight: 600;
    color: #e5e7eb;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .toolbelt-explore-btn:hover {
    background: rgba(1, 172, 106, 0.16);
    border-color: var(--primary, #01ac6a);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(1, 172, 106, 0.2);
  }

  :global([data-theme="light"]) .toolbelt-explore-btn {
    background: rgba(1, 172, 106, 0.08);
    border: 1px solid rgba(1, 172, 106, 0.35);
    color: #111827;
  }

  :global([data-theme="light"]) .toolbelt-explore-btn:hover {
    background: rgba(1, 172, 106, 0.14);
    color: #017a4b;
  }













  .text-primary {
    color: var(--primary, #01ac6a);
  }
</style>
