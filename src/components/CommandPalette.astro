---
import { projects } from '../data/projects';
import { articles } from '../data/articles';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const systemNav = [
  { id: 'nav-home', label: 'Home Cockpit', path: base, category: 'Navigation', icon: 'fas fa-terminal', desc: 'Main systems cockpit & live telemetry runner' },
  { id: 'nav-about', label: 'About Engineer', path: `${base}about/`, category: 'Navigation', icon: 'fas fa-user-gear', desc: 'Engineering dossier, background & systems philosophy' },
  { id: 'nav-projects', label: 'Schematics Catalog', path: `${base}projects/`, category: 'Navigation', icon: 'fas fa-microchip', desc: 'All verified engineering builds & system schematics' },
  { id: 'nav-certs', label: 'Credentials Registry', path: `${base}certificates/`, category: 'Navigation', icon: 'fas fa-certificate', desc: 'Google, Python, and Linux accredited credentials' },
  { id: 'nav-skills', label: 'System Competencies', path: `${base}skills-experience/`, category: 'Navigation', icon: 'fas fa-chart-line', desc: 'Live btop process monitor & toolbelt capability matrix' },
  { id: 'nav-articles', label: 'Incident Logs & Runbooks', path: `${base}articles/`, category: 'Navigation', icon: 'fas fa-book', desc: 'Technical incident logs, Linux networking & security papers' },
  { id: 'nav-hire', label: 'Engineering Handshake', path: `${base}hire-me/`, category: 'Navigation', icon: 'fas fa-handshake', desc: 'Curriculum Vitae, terminal resume spec & direct email' },
  { id: 'nav-personal', label: 'Personal Creative Space', path: `${base}me/`, category: 'Navigation', icon: 'fas fa-pen-nib', desc: 'Urdu literature, poetry, and photography (/me ↗)' }
];
---

<div class="cmd-palette-backdrop" id="cmd-palette-backdrop" aria-hidden="true">
  <div class="cmd-palette-dialog" role="dialog" aria-modal="true" aria-label="Command Telemetry Palette">
    
    <!-- Top Search Header -->
    <div class="cmd-search-bar">
      <span class="cmd-prompt-glyph">&gt;_</span>
      <input 
        type="text" 
        id="cmd-palette-input" 
        class="cmd-search-input" 
        placeholder="Type a command or search (e.g., 'projects', 'theme', 'valgrind')..." 
        autocomplete="off" 
        spellcheck="false" 
      />
      <div class="cmd-search-badges">
        <kbd class="cmd-badge">ESC</kbd>
      </div>
    </div>

    <!-- Results Container -->
    <div class="cmd-results-wrapper" id="cmd-results-wrapper">
      
      <!-- Section: System Navigation -->
      <div class="cmd-group" data-group="navigation">
        <div class="cmd-group-title">
          <span class="cmd-group-bracket">[</span>
          <span>ROUTING &bull; SYSTEM RUNBOOKS</span>
          <span class="cmd-group-bracket">]</span>
        </div>
        <ul class="cmd-list">
          {systemNav.map((item) => (
            <li class="cmd-item" data-type="link" data-url={item.path} data-search={`${item.label} ${item.desc} ${item.path}`}>
              <div class="cmd-item-icon">
                <i class={item.icon}></i>
              </div>
              <div class="cmd-item-meta">
                <span class="cmd-item-title">{item.label}</span>
                <span class="cmd-item-desc">{item.desc}</span>
              </div>
              <span class="cmd-item-arrow">&rarr;</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Section: Quick Actions -->
      <div class="cmd-group" data-group="actions">
        <div class="cmd-group-title">
          <span class="cmd-group-bracket">[</span>
          <span>SYSTEM CONTROLS &bull; DAEMON ACTIONS</span>
          <span class="cmd-group-bracket">]</span>
        </div>
        <ul class="cmd-list">
          <li class="cmd-item" data-type="action" data-action="toggle-theme" data-search="toggle theme switch dark light mode display">
            <div class="cmd-item-icon">
              <i class="fas fa-circle-half-stroke"></i>
            </div>
            <div class="cmd-item-meta">
              <span class="cmd-item-title">Toggle Display Theme</span>
              <span class="cmd-item-desc">Switch between OLED Stealth and Paper Slate modes</span>
            </div>
            <kbd class="cmd-kbd-tag">Action</kbd>
          </li>
          <li class="cmd-item" data-type="action" data-action="copy-email" data-search="copy email contact proton handshake">
            <div class="cmd-item-icon">
              <i class="fas fa-envelope"></i>
            </div>
            <div class="cmd-item-meta">
              <span class="cmd-item-title">Copy Encrypted Email</span>
              <span class="cmd-item-desc">Copies arehman.dev@proton.me to clipboard</span>
            </div>
            <kbd class="cmd-kbd-tag">Copy</kbd>
          </li>
          <li class="cmd-item" data-type="link" data-url="https://github.com/arehman-dev/arehman-dev.github.io" data-search="github source repository code git">
            <div class="cmd-item-icon">
              <i class="fab fa-github"></i>
            </div>
            <div class="cmd-item-meta">
              <span class="cmd-item-title">Inspect Source Repository</span>
              <span class="cmd-item-desc">View the open source Astro codebase on GitHub</span>
            </div>
            <span class="cmd-item-arrow">↗</span>
          </li>
        </ul>
      </div>

      <!-- Section: Engineering Schematics -->
      <div class="cmd-group" data-group="schematics">
        <div class="cmd-group-title">
          <span class="cmd-group-bracket">[</span>
          <span>ENGINEERING SCHEMATICS &bull; VERIFIED BUILDS</span>
          <span class="cmd-group-bracket">]</span>
        </div>
        <ul class="cmd-list">
          {projects.map((proj) => (
            <li class="cmd-item" data-type="link" data-url={`${base}projects/${proj.slug}/`} data-search={`${proj.title} ${proj.description} ${proj.tags.join(' ')}`}>
              <div class="cmd-item-icon">
                <i class="fas fa-microchip text-primary"></i>
              </div>
              <div class="cmd-item-meta">
                <span class="cmd-item-title">{proj.title}</span>
                <span class="cmd-item-desc">{proj.tags.slice(0, 3).map(t => `#${t.toLowerCase()}`).join(' ')} &bull; {proj.status}</span>
              </div>
              <span class="cmd-item-arrow">&rarr;</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Section: Technical Papers & Incident Logs -->
      <div class="cmd-group" data-group="articles">
        <div class="cmd-group-title">
          <span class="cmd-group-bracket">[</span>
          <span>INCIDENT LOGS &bull; TECHNICAL RUNBOOKS</span>
          <span class="cmd-group-bracket">]</span>
        </div>
        <ul class="cmd-list">
          {articles.map((art) => (
            <li class="cmd-item" data-type="link" data-url={`${base}articles/${art.slug}/`} data-search={`${art.title} ${art.excerpt} ${art.category}`}>
              <div class="cmd-item-icon">
                <i class="fas fa-file-lines"></i>
              </div>
              <div class="cmd-item-meta">
                <span class="cmd-item-title">{art.title}</span>
                <span class="cmd-item-desc">#{art.category.toLowerCase()} &bull; {art.readTime}</span>
              </div>
              <span class="cmd-item-arrow">&rarr;</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empty Filter State -->
      <div class="cmd-empty-state" id="cmd-empty-state">
        <i class="fas fa-triangle-exclamation empty-icon"></i>
        <span class="empty-title">NO MATCHING TELEMETRY DAEMONS</span>
        <p class="empty-desc">No commands, schematics, or incident logs matched your query.</p>
      </div>

    </div>

    <!-- Bottom Telemetry Status Bar -->
    <div class="cmd-footer">
      <div class="cmd-footer-keys">
        <span><kbd>↑</kbd> <kbd>↓</kbd> Navigate</span>
        <span class="key-sep">&bull;</span>
        <span><kbd>ENTER</kbd> Select</span>
        <span class="key-sep">&bull;</span>
        <span><kbd>ESC</kbd> Close</span>
      </div>
      <div class="cmd-footer-version">
        <span class="cmd-dot"></span>
        <span>TELESCOPE RUNNER v4.0</span>
      </div>
    </div>

  </div>
</div>

<style>
  .cmd-palette-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 10vh 1.25rem 2rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .cmd-palette-backdrop.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .cmd-palette-dialog {
    width: 100%;
    max-width: 680px;
    background: #0a0b0e;
    border: 1px solid rgba(1, 172, 106, 0.35);
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(1, 172, 106, 0.12);
    overflow: hidden;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    display: flex;
    flex-direction: column;
    max-height: 75vh;
    transform: scale(0.97) translateY(-8px);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cmd-palette-backdrop.active .cmd-palette-dialog {
    transform: scale(1) translateY(0);
  }

  :global([data-theme="light"]) .cmd-palette-dialog {
    background: #ffffff;
    border: 1px solid rgba(1, 172, 106, 0.4);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15), 0 0 20px rgba(1, 172, 106, 0.08);
  }

  /* Search Bar */
  .cmd-search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="light"]) .cmd-search-bar {
    background: #f8fafc;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .cmd-prompt-glyph {
    color: var(--primary, #01ac6a);
    font-size: 1.1rem;
    font-weight: 800;
  }

  .cmd-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 0.95rem;
    color: #f3f4f6;
  }

  :global([data-theme="light"]) .cmd-search-input {
    color: #0f172a;
  }

  .cmd-search-input::placeholder {
    color: #6b7280;
    font-size: 0.85rem;
  }

  :global([data-theme="light"]) .cmd-search-input::placeholder {
    color: #94a3b8;
  }

  .cmd-badge {
    display: inline-block;
    padding: 2px 6px;
    font-size: 0.65rem;
    font-family: inherit;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    color: #9ca3af;
  }

  :global([data-theme="light"]) .cmd-badge {
    background: #e2e8f0;
    border-color: rgba(0, 0, 0, 0.1);
    color: #475569;
  }

  /* Results List */
  .cmd-results-wrapper {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 0.6rem;
    max-height: 52vh;
  }

  .cmd-group {
    margin-bottom: 1rem;
  }

  .cmd-group.hidden {
    display: none;
  }

  .cmd-group-title {
    font-size: 0.65rem;
    font-weight: 700;
    color: #6b7280;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.65rem;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  :global([data-theme="light"]) .cmd-group-title {
    color: #64748b;
  }

  .cmd-group-bracket {
    color: var(--primary, #01ac6a);
  }

  .cmd-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0.55rem 0.75rem;
    border-radius: 5px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background 0.12s ease, border-color 0.12s ease;
  }

  .cmd-item.hidden {
    display: none;
  }

  .cmd-item.selected, .cmd-item:hover {
    background: rgba(1, 172, 106, 0.14);
    border-color: rgba(1, 172, 106, 0.35);
  }

  :global([data-theme="light"]) .cmd-item.selected, 
  :global([data-theme="light"]) .cmd-item:hover {
    background: rgba(1, 172, 106, 0.1);
    border-color: rgba(1, 172, 106, 0.4);
  }

  .cmd-item-icon {
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--primary, #01ac6a);
    flex-shrink: 0;
  }

  :global([data-theme="light"]) .cmd-item-icon {
    background: #f1f5f9;
    border-color: rgba(0, 0, 0, 0.08);
  }

  .cmd-item-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cmd-item-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: #e5e7eb;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global([data-theme="light"]) .cmd-item-title {
    color: #0f172a;
  }

  .cmd-item.selected .cmd-item-title {
    color: var(--primary, #01ac6a);
  }

  :global([data-theme="light"]) .cmd-item.selected .cmd-item-title {
    color: #017a4b;
  }

  .cmd-item-desc {
    font-size: 0.68rem;
    color: #9ca3af;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global([data-theme="light"]) .cmd-item-desc {
    color: #64748b;
  }

  .cmd-item-arrow {
    color: #6b7280;
    font-size: 0.8rem;
    transition: transform 0.15s ease;
  }

  .cmd-item.selected .cmd-item-arrow {
    color: var(--primary, #01ac6a);
    transform: translateX(2px);
  }

  .cmd-kbd-tag {
    font-size: 0.6rem;
    padding: 1px 5px;
    background: rgba(1, 172, 106, 0.1);
    border: 1px solid rgba(1, 172, 106, 0.25);
    border-radius: 3px;
    color: var(--primary, #01ac6a);
  }

  /* Empty State */
  .cmd-empty-state {
    display: none;
    text-align: center;
    padding: 2.5rem 1rem;
    color: #9ca3af;
  }

  .cmd-empty-state.active {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .empty-icon {
    font-size: 1.6rem;
    color: #ef4444;
    margin-bottom: 0.6rem;
  }

  .empty-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #f3f4f6;
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }

  :global([data-theme="light"]) .empty-title {
    color: #111827;
  }

  .empty-desc {
    font-size: 0.72rem;
    margin: 0;
  }

  /* Footer */
  .cmd-footer {
    padding: 0.65rem 1.25rem;
    background: rgba(0, 0, 0, 0.4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.68rem;
    color: #6b7280;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global([data-theme="light"]) .cmd-footer {
    background: #f8fafc;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    color: #64748b;
  }

  .cmd-footer-keys {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cmd-footer-keys kbd {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    padding: 1px 4px;
    font-size: 0.62rem;
    color: #9ca3af;
  }

  :global([data-theme="light"]) .cmd-footer-keys kbd {
    background: #e2e8f0;
    border-color: rgba(0, 0, 0, 0.1);
    color: #334155;
  }

  .key-sep {
    color: rgba(1, 172, 106, 0.4);
  }

  .cmd-footer-version {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--primary, #01ac6a);
    font-weight: 700;
    font-size: 0.65rem;
  }

  .cmd-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary, #01ac6a);
    box-shadow: 0 0 6px var(--primary, #01ac6a);
  }
</style>

<script>
  function setupCommandPalette() {
    const backdrop = document.getElementById('cmd-palette-backdrop');
    const input = document.getElementById('cmd-palette-input') as HTMLInputElement;
    const items = document.querySelectorAll<HTMLElement>('.cmd-item');
    const groups = document.querySelectorAll<HTMLElement>('.cmd-group');
    const emptyState = document.getElementById('cmd-empty-state');
    const triggerBtn = document.getElementById('nav-cmd-trigger');

    if (!backdrop || !input) return;

    let selectedIndex = 0;

    function getVisibleItems(): HTMLElement[] {
      return Array.from(items).filter(item => !item.classList.contains('hidden'));
    }

    function updateSelection() {
      const visible = getVisibleItems();
      items.forEach(item => item.classList.remove('selected'));
      if (visible.length > 0) {
        if (selectedIndex >= visible.length) selectedIndex = 0;
        if (selectedIndex < 0) selectedIndex = visible.length - 1;
        visible[selectedIndex].classList.add('selected');
        visible[selectedIndex].scrollIntoView({ block: 'nearest' });
      }
    }

    function openPalette() {
      backdrop.classList.add('active');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      input.value = '';
      filterItems('');
      selectedIndex = 0;
      updateSelection();
      setTimeout(() => input.focus(), 50);
    }

    function closePalette() {
      backdrop.classList.remove('active');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      input.blur();
    }

    function filterItems(query: string) {
      const cleanQuery = query.toLowerCase().trim();
      let matchCount = 0;

      items.forEach(item => {
        const searchText = (item.getAttribute('data-search') || '').toLowerCase();
        const matches = !cleanQuery || searchText.includes(cleanQuery);
        item.classList.toggle('hidden', !matches);
        if (matches) matchCount++;
      });

      // Show/hide groups based on whether any child items are visible
      groups.forEach(group => {
        const hasVisible = group.querySelectorAll('.cmd-item:not(.hidden)').length > 0;
        group.classList.toggle('hidden', !hasVisible);
      });

      if (emptyState) {
        emptyState.classList.toggle('active', matchCount === 0);
      }

      selectedIndex = 0;
      updateSelection();
    }

    function executeItem(item: HTMLElement) {
      const type = item.getAttribute('data-type');
      if (type === 'link') {
        const url = item.getAttribute('data-url');
        if (url) {
          closePalette();
          if (url.startsWith('http')) {
            window.open(url, '_blank', 'noopener,noreferrer');
          } else {
            window.location.href = url;
          }
        }
      } else if (type === 'action') {
        const action = item.getAttribute('data-action');
        if (action === 'toggle-theme') {
          const root = document.documentElement;
          const current = root.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          closePalette();
        } else if (action === 'copy-email') {
          navigator.clipboard.writeText('arehman.dev@proton.me');
          const title = item.querySelector('.cmd-item-title');
          if (title) {
            const orig = title.textContent;
            title.textContent = '✓ Copied arehman.dev@proton.me!';
            setTimeout(() => {
              title.textContent = orig;
              closePalette();
            }, 1000);
          }
        }
      }
    }

    // Input typing filter
    input.addEventListener('input', (e) => {
      filterItems((e.target as HTMLInputElement).value);
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      // Global shortcut: Ctrl+K or Cmd+K
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (backdrop.classList.contains('active')) {
          closePalette();
        } else {
          openPalette();
        }
        return;
      }

      // Shortcut: "/" when not focused on an input/textarea
      const activeTag = document.activeElement?.tagName.toLowerCase();
      if (e.key === '/' && !backdrop.classList.contains('active') && activeTag !== 'input' && activeTag !== 'textarea') {
        e.preventDefault();
        openPalette();
        return;
      }

      if (!backdrop.classList.contains('active')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closePalette();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex++;
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex--;
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const visible = getVisibleItems();
        if (visible[selectedIndex]) {
          executeItem(visible[selectedIndex]);
        }
      }
    });

    // Item click
    items.forEach(item => {
      item.addEventListener('click', () => {
        executeItem(item);
      });
    });

    // Trigger button
    if (triggerBtn) {
      triggerBtn.addEventListener('click', () => {
        openPalette();
      });
    }

    // Click outside to close
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closePalette();
      }
    });
  }

  setupCommandPalette();
  document.addEventListener('astro:page-load', setupCommandPalette);
</script>