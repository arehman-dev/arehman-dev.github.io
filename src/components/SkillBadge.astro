---
interface Props {
  name: string;
  level: 'Advanced' | 'Intermediate' | 'Beginner' | 'Learning' | 'Exam Prep';
  icon?: string;
}

const { name, level, icon } = Astro.props;

// Determine badge class for styling
const getLevelClass = (lvl: string) => {
  switch (lvl.toLowerCase()) {
    case 'advanced': return 'level-advanced';
    case 'intermediate': return 'level-intermediate';
    case 'beginner': return 'level-beginner';
    case 'learning': return 'level-learning';
    case 'exam prep': return 'level-exam-prep';
    default: return '';
  }
};

const levelClass = getLevelClass(level);
---

<div class="skill-badge-container">
  <div class="skill-main">
    {icon && <span class="skill-icon">{icon}</span>}
    <span class="skill-name">{name}</span>
  </div>
  <span class={`skill-level-badge ${levelClass}`}>{level}</span>
</div>

<style>
  .skill-badge-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-card);
    transition: all 0.2s ease;
    width: 100%;
  }

  .skill-badge-container:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    box-shadow: var(--shadow-sm);
  }

  .skill-main {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .skill-icon {
    font-size: 1.1rem;
  }

  .skill-name {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .skill-level-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Specific color levels matching our theme guidelines */
  .level-advanced {
    background-color: rgba(1, 172, 106, 0.1);
    color: var(--primary);
  }
  
  .level-intermediate {
    background-color: rgba(57, 123, 201, 0.1);
    color: var(--secondary);
  }
  
  .level-beginner {
    background-color: var(--gray-100);
    color: var(--text-muted);
  }
  
  [data-theme="dark"] .level-beginner {
    background-color: #2b2b2b;
    color: #94a3b8;
  }

  .level-learning {
    background-color: rgba(192, 255, 20, 0.15);
    color: #98cc00; /* Darker neon for readability on light */
  }

  [data-theme="dark"] .level-learning {
    color: var(--accent);
  }

  .level-exam-prep {
    background-color: rgba(192, 255, 20, 0.15);
    color: #98cc00;
  }

  [data-theme="dark"] .level-exam-prep {
    color: var(--accent);
  }
</style>
