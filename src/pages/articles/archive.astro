---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';

// Sort articles by publishDate descending (newest first)
const sortedArticles = [...articles].sort((a, b) => {
  return new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime();
});
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout 
  title="Articles Archive | Abdul Rehman"
  description="Chronological archive of technical articles written by Python Developer Abdul Rehman."
>
  <div class="archive-container">
    <div class="back-nav mb-lg">
      <a href={`${base}articles/`} class="back-link">
        <i class="fas fa-arrow-left"></i> Back to Articles
      </a>
    </div>

    <header class="page-header">
      <span class="eyebrow">Technical Repository</span>
      <h1>Articles Archive</h1>
      <p class="tagline">A chronological indexing of all published guides, notes, and technical writeups.</p>
    </header>

    <div class="archive-list mt-lg">
      {sortedArticles.map((article) => (
        <div class="archive-row">
          <div class="archive-left">
            <span class="archive-date-col">{article.publishDate}</span>
            <span class="archive-divider">|</span>
            <h2 class="archive-title-col">
              <a href={`${base}articles/${article.slug}/`}>{article.title}</a>
            </h2>
          </div>
          <div class="archive-right">
            <span class="badge badge-completed">{article.category}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-container {
    max-width: 850px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .archive-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
  }

  .archive-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0.5rem;
    border-bottom: 1px solid var(--border-color);
    transition: all 0.25s ease;
    gap: 2rem;
  }

  .archive-row:hover {
    background-color: rgba(1, 172, 106, 0.02);
    padding-left: 1rem;
    padding-right: 1rem;
    border-radius: 6px;
  }

  [data-theme="dark"] .archive-row:hover {
    background-color: rgba(192, 255, 20, 0.02);
  }

  .archive-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .archive-date-col {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    width: 90px; /* Exact width for standard YYYY-MM-DD monospace digits */
    flex-shrink: 0;
  }

  .archive-divider {
    color: var(--border-color);
    font-weight: 300;
    font-size: 0.9rem;
    margin: 0 0.25rem;
    flex-shrink: 0;
  }

  .archive-title-col {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
  }

  .archive-title-col a {
    color: var(--text-main);
    transition: color 0.2s ease;
  }

  .archive-title-col a:hover {
    color: var(--primary);
  }

  .archive-right {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .archive-row {
      gap: 1rem;
    }
  }

  @media (max-width: 639px) {
    .archive-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 1.25rem 0.25rem;
    }
    
    .archive-row:hover {
      padding-left: 0.25rem;
      padding-right: 0.25rem;
      background: none;
    }

    .archive-left {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
    }

    .archive-divider {
      display: inline;
    }
  }
</style>
