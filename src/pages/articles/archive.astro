---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';

// Sort articles by publishDate descending (newest first)
const sortedArticles = [...articles].sort((a, b) => {
  return new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime();
});
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout 
  title="Historical Incident Logs Archive | Abdul Rehman"
  description="Chronological repository of systems incident logs, network topologies, and Linux technical papers written by Abdul Rehman."
>
  <div class="archive-cockpit-container">
    
    <!-- Top Caliper & Return Navigation -->
    <div class="caliper-bar">
      <a href={`${base}articles/`} class="back-link">
        <i class="fas fa-arrow-left"></i>
        <span>RETURN TO SYSTEM LOGS</span>
      </a>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">[INDEX: CHRONOLOGICAL-LOG-RECORDS]</span>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">COUNT: {sortedArticles.length} ENTRIES</span>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">STATUS: 100% INDEXED</span>
    </div>

    <!-- Header Block -->
    <header class="archive-page-header">
      <span class="archive-eyebrow">01 // CHRONOLOGICAL AUDIT TRAIL &amp; TECHNICAL REPOSITORY</span>
      <h1 class="archive-title">Historical Incident Logs</h1>
      <p class="archive-tagline">
        Complete chronological index of all published runbooks, root-cause postmortems, network isolation guides, and systems automation notes.
      </p>
    </header>

    <!-- Chronological Table List -->
    <div class="archive-table-card">
      <div class="archive-table-head">
        <span class="th-cell th-id">LOG ID</span>
        <span class="th-cell th-date">TIMELINE</span>
        <span class="th-cell th-title">INCIDENT LOG SPECIFICATION</span>
        <span class="th-cell th-cat">CATEGORY</span>
        <span class="th-cell th-act">ACTION</span>
      </div>

      <div class="archive-rows-list">
        {sortedArticles.map((article, idx) => {
          const hexId = `0x${((idx + 1) * 73).toString(16).toUpperCase()}`;
          return (
            <article class="archive-item-row">
              <div class="row-cell cell-id">
                <span class="hex-badge">LOG-{hexId}</span>
              </div>
              <div class="row-cell cell-date">
                <i class="far fa-calendar-alt text-primary"></i>
                <span>{article.date}</span>
              </div>
              <div class="row-cell cell-title">
                <h2 class="article-link-title">
                  <a href={`${base}articles/${article.slug}/`}>{article.title}</a>
                </h2>
              </div>
              <div class="row-cell cell-cat">
                <span class="cat-chip">#{article.category.toLowerCase()}</span>
              </div>
              <div class="row-cell cell-act">
                <a href={`${base}articles/${article.slug}/`} class="inspect-btn" title="Inspect Runbook">
                  <span>open</span>
                  <i class="fas fa-arrow-right"></i>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .archive-cockpit-container {
    max-width: 1060px;
    margin: 0 auto;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    color: #e5e7eb;
  }

  [data-theme="light"] .archive-cockpit-container {
    color: #1f2937;
  }

  /* Caliper Top Bar */
  .caliper-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    color: #9ca3af;
    margin-bottom: 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow-x: auto;
    white-space: nowrap;
  }

  [data-theme="light"] .caliper-bar {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    color: #4b5563;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary, #01ac6a);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .back-link:hover {
    color: #00c47a;
    transform: translateX(-2px);
  }

  .caliper-div {
    color: #4b5563;
  }

  [data-theme="light"] .caliper-div {
    color: #9ca3af;
  }

  /* Header */
  .archive-page-header {
    margin-bottom: 2.25rem;
  }

  .archive-eyebrow {
    font-size: 0.8rem;
    color: var(--primary, #01ac6a);
    font-weight: 700;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .archive-title {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 2.25rem;
    font-weight: 800;
    color: #f3f4f6;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  [data-theme="light"] .archive-title {
    color: #111827;
  }

  .archive-tagline {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 1rem;
    color: #9ca3af;
    max-width: 760px;
    line-height: 1.6;
    margin: 0;
  }

  [data-theme="light"] .archive-tagline {
    color: #4b5563;
  }

  /* Table Card */
  .archive-table-card {
    background: #080808;
    border: 1px solid rgba(1, 172, 106, 0.25);
    border-radius: 8px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    margin-bottom: 3.5rem;
  }

  [data-theme="light"] .archive-table-card {
    background: #ffffff;
    border: 1px solid rgba(1, 172, 106, 0.35);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  }

  .archive-table-head {
    display: grid;
    grid-template-columns: 120px 140px 1fr 140px 100px;
    padding: 0.85rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.68rem;
    color: #6b7280;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  [data-theme="light"] .archive-table-head {
    background: #f9fafb;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    color: #374151;
  }

  .th-act {
    text-align: right;
  }

  .archive-rows-list {
    display: flex;
    flex-direction: column;
  }

  .archive-item-row {
    display: grid;
    grid-template-columns: 120px 140px 1fr 140px 100px;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  [data-theme="light"] .archive-item-row {
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .archive-item-row:hover {
    background: rgba(1, 172, 106, 0.04);
  }

  .hex-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary, #01ac6a);
  }

  .cell-date {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: #9ca3af;
  }

  [data-theme="light"] .cell-date {
    color: #4b5563;
  }

  .article-link-title {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.35;
  }

  .article-link-title a {
    color: #f3f4f6;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  [data-theme="light"] .article-link-title a {
    color: #111827;
  }

  .article-link-title a:hover {
    color: var(--primary, #01ac6a);
  }

  .cat-chip {
    font-size: 0.68rem;
    background: rgba(1, 172, 106, 0.08);
    color: var(--primary, #01ac6a);
    border: 1px solid rgba(1, 172, 106, 0.2);
    padding: 2px 7px;
    border-radius: 4px;
  }

  [data-theme="light"] .cat-chip {
    color: #017a4b;
    border-color: rgba(1, 172, 106, 0.35);
  }

  .cell-act {
    text-align: right;
  }

  .inspect-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--primary, #01ac6a);
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(1, 172, 106, 0.1);
    border: 1px solid rgba(1, 172, 106, 0.3);
    transition: all 0.15s ease;
  }

  [data-theme="light"] .inspect-btn {
    color: #017a4b;
    border-color: rgba(1, 172, 106, 0.4);
  }

  .inspect-btn i {
    transition: transform 0.15s ease;
  }

  .inspect-btn:hover {
    background: var(--primary, #01ac6a);
    color: #ffffff;
  }

  .inspect-btn:hover i {
    transform: translateX(3px);
  }

  .text-primary {
    color: var(--primary, #01ac6a);
  }

  @media (max-width: 860px) {
    .archive-table-head {
      display: none;
    }
    .archive-item-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1rem;
    }
    .cell-act {
      text-align: left;
    }
  }
</style>
