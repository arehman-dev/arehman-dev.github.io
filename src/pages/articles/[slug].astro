---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
import type { Article } from '../../data/articles';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout 
  title={`${article.title} | Abdul Rehman Articles`}
  description={article.excerpt}
>
  <div class="article-detail-container">
    <div class="back-nav mb-lg">
      <a href={`${base}articles/`} class="back-link">
        <i class="fas fa-arrow-left"></i> Back to Articles
      </a>
    </div>

    <article class="article-main card">
      <header class="article-header">
        <span class="badge badge-completed">{article.category}</span>
        <h1 class="article-title">{article.title}</h1>
        
        <div class="meta-row">
          <span class="meta-item"><i class="far fa-calendar"></i> {article.date}</span>
          <span class="meta-item"><i class="far fa-clock"></i> {article.readTime}</span>
        </div>
      </header>

      <!-- Render the hosted article body -->
      <div class="article-body-content" set:html={article.content} />
    </article>
  </div>
</BaseLayout>

<style>
  .article-detail-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .article-main {
    padding: 3rem 2.5rem;
  }

  @media (max-width: 639px) {
    .article-main {
      padding: 1.5rem;
    }
  }

  .article-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .article-title {
    font-size: 2.5rem;
    line-height: 1.25;
    margin-top: 1rem;
    margin-bottom: 0.75rem;
  }

  .meta-row {
    display: flex;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .meta-item i {
    margin-right: 0.35rem;
    color: var(--secondary);
  }

  /* Styling for the rendered HTML body of the article */
  .article-body-content :global(p) {
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .article-body-content :global(h3) {
    font-size: 1.45rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .article-body-content :global(pre) {
    background-color: var(--gray-50);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .article-body-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .article-body-content :global(ul), .article-body-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: var(--text-main);
  }

  .article-body-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
</style>
