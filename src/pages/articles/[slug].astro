---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
import type { Article } from '../../data/articles';

export async function getStaticPaths() {
  return articles.map((article, index) => {
    const prevArticle = index > 0 ? articles[index - 1] : null;
    const nextArticle = index < articles.length - 1 ? articles[index + 1] : null;
    const hexId = `0x${((index + 1) * 73).toString(16).toUpperCase()}`;
    return {
      params: { slug: article.slug },
      props: { article, hexId, prevArticle, nextArticle }
    };
  });
}

interface Props {
  article: Article;
  hexId: string;
  prevArticle: Article | null;
  nextArticle: Article | null;
}

const { article, hexId, prevArticle, nextArticle } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout 
  title={`${article.title} | System Log ${hexId}`}
  description={article.excerpt}
>
  <div class="article-reader-container">
    
    <!-- Top Caliper & Breadcrumb Navigation -->
    <div class="caliper-bar">
      <a href={`${base}articles/`} class="back-link">
        <i class="fas fa-arrow-left"></i>
        <span>RETURN TO SYSTEM LOGS ARCHIVE</span>
      </a>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">[LOG-{hexId}]</span>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">PUBLISHED: {article.date}</span>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">FORMAT: LINUX RUNBOOK</span>
    </div>

    <!-- Article Reader Surface -->
    <article class="reader-surface" id="reader-article-surface" data-reader-theme="default">
      <header class="reader-header">
        <div class="reader-top-bar">
          <div class="tag-meta-group">
            <span class="log-hex-badge">LOG-{hexId}</span>
            <span class="category-pill">#{article.category.toLowerCase()}</span>
          </div>

          <!-- Reading Comfort Theme Switcher -->
          <div class="reader-theme-bar" role="group" aria-label="Reading comfort theme">
            <span class="reader-label"><i class="fas fa-eye"></i> Comfort:</span>
            <button type="button" class="reader-theme-btn active" data-set-reader="default">Default</button>
            <button type="button" class="reader-theme-btn" data-set-reader="sepia">Sepia</button>
            <button type="button" class="reader-theme-btn" data-set-reader="sepia-contrast">Sepia Dark</button>
            <button type="button" class="reader-theme-btn" data-set-reader="soft-contrast">Soft Contrast</button>
          </div>
        </div>

        <h1 class="reader-title">{article.title}</h1>
        
        <div class="reader-meta-row">
          <span class="meta-item"><i class="far fa-calendar-alt"></i> {article.date}</span>
          <span class="meta-item"><i class="far fa-clock"></i> {article.readTime}</span>
          <span class="meta-item text-primary"><i class="fas fa-check-shield"></i> Verified Technical Content</span>
        </div>
      </header>

      <!-- Hosted Article Body -->
      <div class="article-body-content" id="article-body-content" set:html={article.content} />

      <!-- Bottom Prev / Next Navigation -->
      <footer class="reader-footer-nav">
        <div class="nav-prev-box">
          {prevArticle ? (
            <a href={`${base}articles/${prevArticle.slug}/`} class="log-nav-link prev-link">
              <span class="nav-sub">&larr; PREVIOUS INCIDENT LOG</span>
              <strong class="nav-title">{prevArticle.title}</strong>
            </a>
          ) : (
            <div class="log-nav-placeholder"></div>
          )}
        </div>

        <div class="nav-next-box">
          {nextArticle ? (
            <a href={`${base}articles/${nextArticle.slug}/`} class="log-nav-link next-link">
              <span class="nav-sub">NEXT INCIDENT LOG &rarr;</span>
              <strong class="nav-title">{nextArticle.title}</strong>
            </a>
          ) : (
            <div class="log-nav-placeholder"></div>
          )}
        </div>
      </footer>
    </article>
  </div>
</BaseLayout>

<script is:inline>
  function initReaderSurface() {
    // 1. Reading Comfort Theme Switcher
    const surface = document.getElementById('reader-article-surface');
    const buttons = document.querySelectorAll('.reader-theme-btn[data-set-reader]');
    if (surface && buttons.length) {
      const applyReaderTheme = (mode) => {
        surface.setAttribute('data-reader-theme', mode);
        buttons.forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-set-reader') === mode);
        });
      };

      const savedMode = typeof localStorage !== 'undefined' ? localStorage.getItem('reader-theme') : null;
      if (savedMode && ['default', 'sepia', 'sepia-contrast', 'soft-contrast'].includes(savedMode)) {
        applyReaderTheme(savedMode);
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-set-reader') || 'default';
          applyReaderTheme(mode);
          if (typeof localStorage !== 'undefined') {
            localStorage.setItem('reader-theme', mode);
          }
        });
      });
    }

    // 2. Interactive Code Block Terminal Header & Copy Buttons
    const bodyContent = document.getElementById('article-body-content');
    if (bodyContent) {
      const pres = bodyContent.querySelectorAll('pre');
      pres.forEach((pre) => {
        if (pre.parentNode && pre.parentNode.classList.contains('code-terminal-wrapper')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-terminal-wrapper';

        const bar = document.createElement('div');
        bar.className = 'code-terminal-bar';
        bar.innerHTML = `
          <div class="code-dots">
            <span class="code-dot dot-r"></span>
            <span class="code-dot dot-y"></span>
            <span class="code-dot dot-g"></span>
            <span class="code-lbl">bash / terminal buffer</span>
          </div>
          <button type="button" class="code-copy-btn" title="Copy code snippet">
            <i class="far fa-copy"></i> <span>copy</span>
          </button>
        `;

        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(bar);
        wrapper.appendChild(pre);

        const copyBtn = bar.querySelector('.code-copy-btn');
        if (copyBtn) {
          copyBtn.addEventListener('click', () => {
            const codeText = pre.innerText || pre.textContent || '';
            navigator.clipboard.writeText(codeText).then(() => {
              const span = copyBtn.querySelector('span');
              if (span) span.textContent = 'copied!';
              setTimeout(() => {
                if (span) span.textContent = 'copy';
              }, 1800);
            });
          });
        }
      });
    }
  }

  initReaderSurface();
  document.addEventListener('astro:page-load', initReaderSurface);
</script>

<style>
  .article-reader-container {
    max-width: 860px;
    margin: 0 auto;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  /* Caliper Bar */
  .caliper-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.7rem;
    color: #6b7280;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    overflow-x: auto;
    white-space: nowrap;
  }

  :global([data-theme="light"]) .caliper-bar {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    color: #4b5563;
  }

  .back-link {
    color: var(--primary, #01ac6a);
    text-decoration: none;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: opacity 0.15s ease;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .caliper-div {
    color: var(--primary, #01ac6a);
  }

  /* Reader Surface */
  .reader-surface {
    background: #0d0f12;
    border: 1px solid rgba(1, 172, 106, 0.22);
    border-radius: 8px;
    padding: 2.5rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    margin-bottom: 4rem;
    position: relative;
    overflow: hidden;
  }

  :global([data-theme="light"]) .reader-surface {
    background: #ffffff;
    border: 1px solid rgba(1, 172, 106, 0.3);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
  }

  .reader-surface::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #01ac6a, #00c47a, #397bc9);
  }

  .reader-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="light"]) .reader-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .reader-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .tag-meta-group {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
  }

  .log-hex-badge {
    background: rgba(1, 172, 106, 0.14);
    color: var(--primary, #01ac6a);
    border: 1px solid rgba(1, 172, 106, 0.35);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 3px;
  }

  .category-pill {
    color: #9ca3af;
    font-size: 0.72rem;
  }

  /* Theme Switcher */
  .reader-theme-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 2px 4px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.7rem;
  }

  :global([data-theme="light"]) .reader-theme-bar {
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .reader-label {
    color: #6b7280;
    padding: 0 4px;
  }

  .reader-theme-btn {
    background: transparent;
    border: none;
    color: #9ca3af;
    font-family: inherit;
    font-size: 0.68rem;
    padding: 2px 6px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .reader-theme-btn:hover {
    color: #f3f4f6;
  }
  :global([data-theme="light"]) .reader-theme-btn:hover {
    color: #111827;
  }

  .reader-theme-btn.active {
    background: rgba(1, 172, 106, 0.18);
    color: var(--primary, #01ac6a);
    font-weight: 700;
  }

  .reader-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: #f3f4f6;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  :global([data-theme="light"]) .reader-title {
    color: #111827;
  }

  .reader-meta-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    color: #9ca3af;
    flex-wrap: wrap;
  }

  .text-primary {
    color: var(--primary, #01ac6a);
  }

  /* Body Content Typography & Styles */
  .article-body-content {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #d1d5db;
  }

  :global([data-theme="light"]) .article-body-content {
    color: #27272a;
  }

  .article-body-content h2, 
  .article-body-content h3, 
  .article-body-content h4 {
    color: #f3f4f6;
    margin: 2.5rem 0 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  :global([data-theme="light"]) .article-body-content h2,
  :global([data-theme="light"]) .article-body-content h3,
  :global([data-theme="light"]) .article-body-content h4 {
    color: #111827;
  }

  .article-body-content p {
    margin-bottom: 1.4rem;
  }

  .article-body-content ul, 
  .article-body-content ol {
    margin: 1rem 0 1.5rem 1.5rem;
  }

  .article-body-content li {
    margin-bottom: 0.5rem;
  }

  .article-body-content a {
    color: var(--primary, #01ac6a);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-body-content code:not(pre code) {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #a7f3d0;
    padding: 2px 6px;
    border-radius: 4px;
  }

  :global([data-theme="light"]) .article-body-content code:not(pre code) {
    background: rgba(1, 172, 106, 0.08);
    border: 1px solid rgba(1, 172, 106, 0.25);
    color: #017a4b;
    font-weight: 500;
  }

  /* Code Terminal Wrapper injected by JS */
  :global(.code-terminal-wrapper) {
    background: #08090b;
    border: 1px solid rgba(1, 172, 106, 0.25);
    border-radius: 6px;
    overflow: hidden;
    margin: 1.75rem 0;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5);
  }

  :global(.code-terminal-bar) {
    background: #121418;
    padding: 6px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.code-dots) {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  :global(.code-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  :global(.dot-r) { background: #ff5f56; }
  :global(.dot-y) { background: #ffbd2e; }
  :global(.dot-g) { background: #27c93f; }

  :global(.code-lbl) {
    margin-left: 6px;
    color: #6b7280;
    font-size: 0.68rem;
  }

  :global(.code-copy-btn) {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #9ca3af;
    font-family: inherit;
    font-size: 0.68rem;
    padding: 2px 7px;
    border-radius: 3px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.15s ease;
  }

  :global(.code-copy-btn:hover) {
    background: rgba(1, 172, 106, 0.2);
    color: #ffffff;
    border-color: var(--primary, #01ac6a);
  }

  :global(.code-terminal-wrapper pre) {
    margin: 0 !important;
    padding: 1.15rem !important;
    font-size: 0.82rem !important;
    line-height: 1.6 !important;
    color: #e5e7eb !important;
    overflow-x: auto !important;
    background: transparent !important;
  }

  /* Reading Comfort Theme Styles */
  .reader-surface[data-reader-theme="sepia"] {
    background-color: #f7f1e5;
    color: #3d352a;
    border-color: rgba(180, 140, 80, 0.3);
  }
  .reader-surface[data-reader-theme="sepia"] .reader-title {
    color: #2c251d;
  }
  .reader-surface[data-reader-theme="sepia"] .article-body-content {
    color: #3d352a;
  }

  .reader-surface[data-reader-theme="sepia-contrast"] {
    background-color: #1e1915;
    color: #d6cbbe;
    border-color: rgba(217, 119, 6, 0.3);
  }
  .reader-surface[data-reader-theme="sepia-contrast"] .reader-title {
    color: #f3ece4;
  }
  .reader-surface[data-reader-theme="sepia-contrast"] .article-body-content {
    color: #d6cbbe;
  }

  .reader-surface[data-reader-theme="soft-contrast"] {
    background-color: #e5e7eb;
    color: #111827;
    border-color: rgba(100, 116, 139, 0.3);
  }
  .reader-surface[data-reader-theme="soft-contrast"] .reader-title {
    color: #030712;
  }
  .reader-surface[data-reader-theme="soft-contrast"] .article-body-content {
    color: #111827;
  }

  /* Footer Navigation */
  .reader-footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="light"]) .reader-footer-nav {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .log-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  :global([data-theme="light"]) .log-nav-link {
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .log-nav-link:hover {
    background: rgba(1, 172, 106, 0.08);
    border-color: var(--primary, #01ac6a);
    transform: translateY(-2px);
  }

  .next-link {
    text-align: right;
  }

  .nav-sub {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.68rem;
    color: var(--primary, #01ac6a);
    font-weight: 700;
  }

  .nav-title {
    font-size: 0.92rem;
    color: #f3f4f6;
    line-height: 1.4;
  }
  :global([data-theme="light"]) .nav-title {
    color: #111827;
  }

  @media (max-width: 768px) {
    .reader-surface {
      padding: 1.5rem;
    }
    .reader-title {
      font-size: 1.75rem;
    }
    .reader-footer-nav {
      grid-template-columns: 1fr;
    }
    .next-link {
      text-align: left;
    }
  }
</style>
