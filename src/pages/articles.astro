---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout 
  title="Articles | Abdul Rehman Portfolio"
  description="Read articles written by Abdul Rehman covering Linux server security, shell scripting automation, and system administration workflows."
>
  <div class="articles-container">
    <header class="page-header">
      <div class="header-flex-row">
        <div>
          <span class="eyebrow">Sharing Knowledge</span>
          <h1>Technical Articles</h1>
        </div>
        <a href={`${base}articles/archive/`} class="btn btn-outline btn-sm archive-btn">
          <i class="fas fa-box-archive"></i> Archive Mode
        </a>
      </div>
      <p class="tagline">Guides, thoughts, and technical analysis on system administration, security, and automation.</p>
    </header>

    <div class="grid grid-3">
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .articles-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 700px;
    margin-top: 0.25rem;
  }

  .header-flex-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .archive-btn {
    align-self: flex-end;
    margin-bottom: 0.25rem;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }
</style>
