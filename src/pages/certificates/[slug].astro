---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { certificates } from '../../data/certificates';
import type { Certificate } from '../../data/certificates';

export async function getStaticPaths() {
  return certificates.map((certificate, index) => {
    const regId = `REG-0x${(index + 1).toString(16).padStart(2, '0').toUpperCase()}`;
    const relatedCerts = certificates
      .filter((c) => c.slug !== certificate.slug)
      .slice(0, 2);
    // Deterministic pseudo-hash for aesthetic cryptographic verification specimen
    const certHash = Array.from(certificate.slug + certificate.issuer)
      .reduce((acc, char) => (acc * 31 + char.charCodeAt(0)) >>> 0, 0x5f3759df)
      .toString(16).padStart(8, '0').toUpperCase();

    return {
      params: { slug: certificate.slug },
      props: { 
        certificate, 
        regId,
        certHash: `SHA256:${certHash}9E74A2B1FD`,
        relatedCerts 
      }
    };
  });
}

interface Props {
  certificate: Certificate;
  regId: string;
  certHash: string;
  relatedCerts: Certificate[];
}

const { certificate, regId, certHash, relatedCerts } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const isCompleted = certificate.status.toLowerCase() === 'completed';
---

<BaseLayout 
  title={`${certificate.title} | Verified Credential ${regId}`}
  description={certificate.description}
>
  <div class="credential-dossier-container">
    
    <!-- Top Caliper Navigation Bar -->
    <div class="caliper-bar">
      <a href={`${base}certificates/`} class="back-link">
        <i class="fas fa-arrow-left"></i>
        <span>RETURN TO CREDENTIALS REGISTRY</span>
      </a>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">[{regId}]</span>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">ISSUER: {certificate.issuer.toUpperCase()}</span>
      <span class="caliper-div">&bull;</span>
      <span class="caliper-tag">STATUS: {certificate.status.toUpperCase()}</span>
    </div>

    <!-- Dossier Header Unit -->
    <header class="dossier-header-unit">
      <div class="dossier-header-top">
        <span class="dossier-spec-tag">
          <i class="fas fa-certificate"></i> ACCREDITED STANDARDS SPECIFICATION
        </span>
        <span class={`status-chip ${isCompleted ? 'status-completed' : 'status-in-progress'}`}>
          <span class="status-indicator"></span>
          {certificate.status.toUpperCase()}
        </span>
      </div>

      <h1 class="dossier-title">{certificate.title}</h1>
      <p class="dossier-summary">{certificate.description}</p>

      <div class="header-telemetry-row">
        <div class="telemetry-pill">
          <i class="far fa-building"></i>
          <span>ISSUER: <strong>{certificate.issuer}</strong></span>
        </div>
        <div class="telemetry-pill">
          <i class="far fa-calendar-alt"></i>
          <span>TIMELINE: <strong>{certificate.date}</strong></span>
        </div>
        {certificate.duration && (
          <div class="telemetry-pill">
            <i class="far fa-clock"></i>
            <span>EFFORT: <strong>{certificate.duration}</strong></span>
          </div>
        )}
        {certificate.difficulty && (
          <div class="telemetry-pill">
            <i class="fas fa-signal"></i>
            <span>RIGOR: <strong>{certificate.difficulty.toUpperCase()}</strong></span>
          </div>
        )}
      </div>

      {certificate.technologies && certificate.technologies.length > 0 && (
        <div class="tags-row">
          {certificate.technologies.map((tech) => (
            <span class="tech-chip">#{tech.toLowerCase()}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Main Content & Sidebar Layout -->
    <div class="dossier-body-grid">
      
      <!-- Left Column: Curriculum Scope & Cryptographic Specimen -->
      <div class="dossier-main-col">
        
        <!-- Section 01: Curriculum Overview & Scope -->
        <section class="dossier-section">
          <div class="section-caliper-head">
            <span class="sec-num">01 //</span>
            <h2 class="sec-title">CURRICULUM SPECIFICATION &amp; AUDIT SCOPE</h2>
          </div>
          <div class="section-card">
            <p class="body-narrative">{certificate.overview}</p>
          </div>
        </section>

        <!-- Section 02: Core Competencies Verified -->
        {certificate.skillsAcquired && certificate.skillsAcquired.length > 0 && (
          <section class="dossier-section">
            <div class="section-caliper-head">
              <span class="sec-num">02 //</span>
              <h2 class="sec-title">VERIFIED CAPABILITIES &amp; COMPETENCIES</h2>
            </div>
            
            <div class="capabilities-grid">
              {certificate.skillsAcquired.map((skill, sIdx) => (
                <div class="capability-item">
                  <div class="cap-index">[{String(sIdx + 1).padStart(2, '0')}]</div>
                  <div class="cap-text">
                    <i class="fas fa-check-circle cap-icon"></i>
                    <span>{skill}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Section 03: Cryptographic Specimen & Digital Certificate Frame -->
        <section class="dossier-section">
          <div class="section-caliper-head">
            <span class="sec-num">03 //</span>
            <h2 class="sec-title">DIGITAL CREDENTIAL SPECIMEN</h2>
            <span class="sec-badge">ENCRYPTED WATERMARK</span>
          </div>

          <div class="specimen-frame">
            <!-- Caliper Corner Markers -->
            <span class="caliper-corner corner-tl">+</span>
            <span class="caliper-corner corner-tr">+</span>
            <span class="caliper-corner corner-bl">+</span>
            <span class="caliper-corner corner-br">+</span>

            <div class="specimen-inner">
              <div class="specimen-top-meta">
                <div class="specimen-serial">SPECIMEN SERIAL: {regId}</div>
                <div class="specimen-hash">{certHash}</div>
              </div>

              <div class="specimen-crest">
                <div class="crest-icon">
                  <i class="fas fa-shield-halved"></i>
                </div>
                <span class="crest-label">ACCREDITED TECHNICAL SPECIFICATION</span>
              </div>

              <div class="specimen-presentation">
                <span class="pres-sub">THIS VERIFIES THAT</span>
                <h3 class="pres-name">Abdul Rehman</h3>
                <span class="pres-role">Systems &amp; Software Engineer</span>
                <span class="pres-body">
                  has undertaken and demonstrated rigorous engineering mastery in the curriculum:
                </span>
                <h4 class="pres-title">{certificate.title}</h4>
                <span class="pres-issuer">ACCREDITED &amp; ISSUED BY: <strong>{certificate.issuer}</strong></span>
              </div>

              <div class="specimen-foot-grid">
                <div class="foot-col">
                  <span class="col-k">STATUS</span>
                  <span class={`col-v ${isCompleted ? 'text-primary' : 'text-amber'}`}>
                    {certificate.status.toUpperCase()}
                  </span>
                </div>
                <div class="foot-col foot-center">
                  <div class="specimen-seal">
                    <span class="seal-inner">
                      <i class="fas fa-certificate"></i>
                      <span>VERIFIED</span>
                    </span>
                  </div>
                </div>
                <div class="foot-col foot-right">
                  <span class="col-k">TIMELINE</span>
                  <span class="col-v">{certificate.date}</span>
                </div>
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Right Column: Verification Telemetry & Parameters -->
      <aside class="dossier-sidebar">
        
        <!-- Verification Portal Card -->
        <div class="sidebar-box verification-box">
          <div class="sidebar-head">
            <i class="fas fa-fingerprint"></i>
            <span>VERIFICATION STATUS</span>
          </div>

          <div class="verif-status-indicator">
            <span class={`status-dot ${isCompleted ? 'status-completed' : 'status-in-progress'}`}></span>
            <div>
              <div class="verif-status-label">{isCompleted ? 'VERIFIED ACCREDITATION' : 'ACTIVE IN-FLIGHT CURRICULUM'}</div>
              <div class="verif-status-sub">{certificate.date}</div>
            </div>
          </div>

          <div class="verif-meta-list">
            <div class="verif-meta-row">
              <span class="v-label">REGISTRY ID:</span>
              <span class="v-val"><code>{regId}</code></span>
            </div>
            <div class="verif-meta-row">
              <span class="v-label">ISSUING ENTITY:</span>
              <span class="v-val">{certificate.issuer}</span>
            </div>
            {certificate.credentialId && (
              <div class="verif-meta-row">
                <span class="v-label">CREDENTIAL ID:</span>
                <span class="v-val"><code>{certificate.credentialId}</code></span>
              </div>
            )}
            <div class="verif-meta-row">
              <span class="v-label">AUDIT HASH:</span>
              <span class="v-val font-mono">{certHash.substring(0, 16)}...</span>
            </div>
          </div>

          <div class="verif-action-wrap">
            {certificate.link ? (
              <a 
                href={certificate.link} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="action-btn-primary"
              >
                <i class="fas fa-external-link-alt"></i>
                <span>LAUNCH ISSUER VERIFICATION</span>
              </a>
            ) : (
              <div class="action-btn-pending">
                <i class="fas fa-spinner fa-spin"></i>
                <span>IN-PROGRESS: DIRECT AUDIT PENDING</span>
              </div>
            )}
          </div>
        </div>

        <!-- Telemetry Parameters Matrix -->
        <div class="sidebar-box">
          <div class="sidebar-head">
            <i class="fas fa-sliders-h"></i>
            <span>CURRICULUM TELEMETRY</span>
          </div>

          <dl class="telemetry-dl">
            {certificate.duration && (
              <div class="dl-row">
                <dt>Estimated Duration</dt>
                <dd>{certificate.duration}</dd>
              </div>
            )}
            {certificate.difficulty && (
              <div class="dl-row">
                <dt>Evaluation Rigor</dt>
                <dd><span class="rigor-badge">{certificate.difficulty}</span></dd>
              </div>
            )}
            <div class="dl-row">
              <dt>Verification Track</dt>
              <dd>Technical &amp; Systems Specialization</dd>
            </div>
            <div class="dl-row">
              <dt>Target Standard</dt>
              <dd>POSIX / Google / Open-Source</dd>
            </div>
          </dl>
        </div>

        <!-- Related Credentials -->
        {relatedCerts.length > 0 && (
          <div class="sidebar-box">
            <div class="sidebar-head">
              <i class="fas fa-layer-group"></i>
              <span>OTHER REGISTRY RECORDS</span>
            </div>

            <div class="related-list">
              {relatedCerts.map((rel) => (
                <a href={`${base}certificates/${rel.slug}/`} class="related-item">
                  <div class="related-head">
                    <span class="related-issuer">{rel.issuer}</span>
                    <span class="related-status">{rel.status}</span>
                  </div>
                  <div class="related-title">{rel.title}</div>
                  <div class="related-arrow">
                    <span>inspect</span>
                    <i class="fas fa-arrow-right"></i>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </aside>

    </div>

  </div>
</BaseLayout>

<style>
  .credential-dossier-container {
    max-width: 1100px;
    margin: 0 auto;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    color: #e5e7eb;
  }

  [data-theme="light"] .credential-dossier-container {
    color: #1f2937;
  }

  /* Top Caliper Bar */
  .caliper-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    color: #9ca3af;
    margin-bottom: 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow-x: auto;
    white-space: nowrap;
  }

  [data-theme="light"] .caliper-bar {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    color: #4b5563;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #01ac6a;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .back-link:hover {
    color: #00c47a;
    transform: translateX(-2px);
  }

  .caliper-div {
    color: #4b5563;
  }

  [data-theme="light"] .caliper-div {
    color: #9ca3af;
  }

  .caliper-tag {
    letter-spacing: 0.04em;
    font-weight: 500;
  }

  /* Dossier Header Unit */
  .dossier-header-unit {
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 1.75rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  [data-theme="light"] .dossier-header-unit {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }

  .dossier-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .dossier-spec-tag {
    font-size: 0.72rem;
    color: #01ac6a;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .status-chip {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .status-chip.status-completed {
    background: rgba(1, 172, 106, 0.12);
    color: #01ac6a;
    border: 1px solid rgba(1, 172, 106, 0.3);
  }

  .status-chip.status-in-progress {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    display: inline-block;
  }

  .status-chip.status-in-progress .status-indicator {
    animation: pulse 1.8s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  .dossier-title {
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: #ffffff;
    margin: 0 0 0.85rem 0;
  }

  [data-theme="light"] .dossier-title {
    color: #111827;
  }

  .dossier-summary {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #9ca3af;
    margin: 0 0 1.25rem 0;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  [data-theme="light"] .dossier-summary {
    color: #4b5563;
  }

  .header-telemetry-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  [data-theme="light"] .header-telemetry-row {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .telemetry-pill {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #9ca3af;
  }

  [data-theme="light"] .telemetry-pill {
    background: #f9fafb;
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #4b5563;
  }

  .telemetry-pill i {
    color: #01ac6a;
  }

  .telemetry-pill strong {
    color: #e5e7eb;
  }

  [data-theme="light"] .telemetry-pill strong {
    color: #111827;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-chip {
    font-size: 0.72rem;
    background: rgba(1, 172, 106, 0.08);
    color: #01ac6a;
    border: 1px solid rgba(1, 172, 106, 0.2);
    padding: 2px 7px;
    border-radius: 4px;
  }

  /* Grid Layout */
  .dossier-body-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .dossier-body-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Section Styling */
  .dossier-section {
    margin-bottom: 2rem;
  }

  .section-caliper-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0.85rem;
  }

  .sec-num {
    color: #01ac6a;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .sec-title {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: #e5e7eb;
    margin: 0;
    text-transform: uppercase;
  }

  [data-theme="light"] .sec-title {
    color: #111827;
  }

  .sec-badge {
    margin-left: auto;
    font-size: 0.65rem;
    color: #6b7280;
    letter-spacing: 0.06em;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1px 6px;
    border-radius: 3px;
  }

  [data-theme="light"] .sec-badge {
    border-color: rgba(0, 0, 0, 0.1);
    color: #4b5563;
  }

  .section-card {
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 1.5rem;
  }

  [data-theme="light"] .section-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .body-narrative {
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
    color: #d1d5db;
    margin: 0;
  }

  [data-theme="light"] .body-narrative {
    color: #374151;
  }

  /* Capabilities Grid */
  .capabilities-grid {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .capability-item {
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 0.85rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  [data-theme="light"] .capability-item {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .capability-item:hover {
    border-color: rgba(1, 172, 106, 0.4);
    background: rgba(1, 172, 106, 0.02);
  }

  .cap-index {
    font-size: 0.72rem;
    color: #6b7280;
    font-weight: 700;
  }

  [data-theme="light"] .cap-index {
    color: #9ca3af;
  }

  .cap-text {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: #e5e7eb;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  [data-theme="light"] .cap-text {
    color: #1f2937;
  }

  .cap-icon {
    color: #01ac6a;
    font-size: 0.85rem;
  }

  /* Cryptographic Specimen Frame */
  .specimen-frame {
    position: relative;
    background: #060606;
    border: 1px solid rgba(1, 172, 106, 0.35);
    border-radius: 8px;
    padding: 2.25rem 2rem;
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.5), inset 0 0 60px rgba(1, 172, 106, 0.02);
  }

  [data-theme="light"] .specimen-frame {
    background: #ffffff;
    border: 1px solid rgba(1, 172, 106, 0.35);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04), inset 0 0 50px rgba(1, 172, 106, 0.02);
  }

  /* Corner Calipers */
  .caliper-corner {
    position: absolute;
    font-size: 0.95rem;
    font-weight: bold;
    color: #01ac6a;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .corner-tl { top: 6px; left: 8px; }
  .corner-tr { top: 6px; right: 8px; }
  .corner-bl { bottom: 6px; left: 8px; }
  .corner-br { bottom: 6px; right: 8px; }

  .specimen-inner {
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 2rem 1.75rem;
    text-align: center;
    position: relative;
  }

  [data-theme="light"] .specimen-inner {
    border: 1px dashed rgba(0, 0, 0, 0.15);
  }

  .specimen-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
    color: #6b7280;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  [data-theme="light"] .specimen-top-meta {
    color: #4b5563;
  }

  .specimen-serial {
    color: #01ac6a;
    font-weight: 700;
  }

  .specimen-crest {
    margin-bottom: 1.25rem;
  }

  .crest-icon {
    font-size: 2rem;
    color: #01ac6a;
    margin-bottom: 0.35rem;
  }

  .crest-label {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: #9ca3af;
    font-weight: 700;
  }

  [data-theme="light"] .crest-label {
    color: #4b5563;
  }

  .specimen-presentation {
    margin-bottom: 2rem;
  }

  .pres-sub {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: #6b7280;
    margin-bottom: 0.4rem;
  }

  [data-theme="light"] .pres-sub {
    color: #4b5563;
  }

  .pres-name {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #ffffff;
    margin: 0 0 0.2rem 0;
  }

  [data-theme="light"] .pres-name {
    color: #111827;
  }

  .pres-role {
    display: block;
    font-size: 0.75rem;
    color: #01ac6a;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .pres-body {
    display: block;
    font-size: 0.85rem;
