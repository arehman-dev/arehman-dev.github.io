---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout 
  title="Projects | Abdul Rehman Portfolio"
  description="Explore the portfolio projects crafted by Abdul Rehman, showcasing Linux infrastructure, scripting automation, extension concepts, and frontend design."
>
  <div class="projects-container">
    <header class="page-header">
      <span class="eyebrow">My Portfolio</span>
      <h1>Featured Projects</h1>
      <p class="tagline">A selection of my recent works covering system administration, scripting utilities, and conceptual designs.</p>
    </header>

    <div class="grid grid-3">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .projects-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 700px;
    margin-top: 0.25rem;
  }
</style>
