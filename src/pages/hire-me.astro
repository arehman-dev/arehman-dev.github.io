<script>
  function setupResumeViewer() {
    const modeBtns = document.querySelectorAll('.cv-mode-btn');
    const viewPanes = document.querySelectorAll('.cv-view-pane');
    const inlineSwitch = document.getElementById('inline-switch-to-term');

    function switchView(targetView: string) {
      modeBtns.forEach(btn => {
        const isTarget = btn.getAttribute('data-view') === targetView;
        btn.classList.toggle('active', isTarget);
        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      viewPanes.forEach(pane => {
        pane.classList.toggle('active', pane.id === `view-${targetView}`);
      });
    }

    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetView = btn.getAttribute('data-view') || 'terminal';
        switchView(targetView);
      });
    });

    if (inlineSwitch) {
      inlineSwitch.addEventListener('click', () => {
        switchView('terminal');
      });
    }

    // Copy Raw Plain Text Handler
    const copyBtn = document.getElementById('copy-terminal-cv-btn');
    const copyLabel = document.getElementById('copy-btn-label');
    const cvBody = document.getElementById('raw-cv-content');

    if (copyBtn && cvBody && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        const textToCopy = cvBody.innerText.replace(/arehman@dev:~\$/g, '$');
        try {
          await navigator.clipboard.writeText(textToCopy);
          const original = copyLabel.textContent;
          copyLabel.textContent = 'Copied!';
          copyBtn.style.color = '#10b981';
          setTimeout(() => {
            copyLabel.textContent = original;
            copyBtn.style.color = '';
          }, 2000);
        } catch {
          // Fallback if clipboard API is restricted
          copyLabel.textContent = 'Press Ctrl+C';
          setTimeout(() => {
            copyLabel.textContent = 'Copy Raw';
          }, 2000);
        }
      });
    }
  }

  setupResumeViewer();
  document.addEventListener('astro:page-load', setupResumeViewer);
</script>