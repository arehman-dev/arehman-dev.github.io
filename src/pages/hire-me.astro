---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Hire Me & Resume | Abdul Rehman Portfolio"
  description="Contact Abdul Rehman for system administration and Python development opportunities. Download my resume and view contact details."
>
  <div class="hire-container">
    <header class="page-header">
      <span class="eyebrow">Ready for Collaboration</span>
      <h1>Hire Me / Let's Connect</h1>
      <p class="tagline">Review my resume and get in touch to discuss positions, collaborations, or opportunities.</p>
    </header>

    <div class="hire-layout">
      <!-- LEFT COLUMN: RESUME VIEWER -->
      <div class="resume-column">
        <div class="card resume-card-container">
          <div class="resume-header">
            <h3>Curriculum Vitae</h3>
            <a 
              href="/assets/documents/resume-abdulrehman.pdf" 
              download 
              class="btn btn-primary btn-sm"
              id="download-resume-btn"
            >
              <i class="fas fa-download"></i> Download Resume
            </a>
          </div>
          
          <div class="pdf-viewer-container">
            <iframe 
              src="/assets/documents/resume-abdulrehman.pdf" 
              title="Abdul Rehman's Resume" 
              width="100%" 
              height="600px"
              class="pdf-iframe"
            >
              <p>It appears you don't have a PDF plugin for this browser. No problem! You can 
                <a href="/assets/documents/resume-abdulrehman.pdf">click here to download the PDF file.</a>
              </p>
            </iframe>
          </div>
          <div class="mobile-pdf-notice">
            <div class="notice-icon"><i class="fas fa-file-pdf"></i></div>
            <p>Resume is available to download. Access on desktop to view the interactive PDF reader.</p>
            <a href="/assets/documents/resume-abdulrehman.pdf" class="btn btn-primary w-full justify-center">
              <i class="fas fa-download"></i> Get PDF Copy
            </a>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: CONTACT DETAILS & CARD -->
      <div class="contact-column">
        <div class="card contact-details-card">
          <h2>Let's Work Together</h2>
          <p class="intro-contact-text">
            I am currently open to opportunities in system administration, Linux management, junior infrastructure roles, and scripting/automation projects.
          </p>

          <div class="info-block-list">
            <div class="info-item">
              <div class="info-icon"><i class="fas fa-envelope"></i></div>
              <div class="info-details">
                <span class="info-label">Email</span>
                <span class="info-value"><a href="mailto:arehman.dev@proton.me">arehman.dev@proton.me</a></span>
              </div>
            </div>
            
            <div class="info-item">
              <div class="info-icon"><i class="fas fa-map-marker-alt"></i></div>
              <div class="info-details">
                <span class="info-label">Location</span>
                <span class="info-value">Pakistan / Remote</span>
              </div>
            </div>
          </div>

          <div class="status-grid mt-lg">
            <div class="status-card">
              <span class="status-icon"><i class="far fa-clock"></i></span>
              <strong>Response Time</strong>
              <span>Within 24-48 hours</span>
            </div>
            <div class="status-card">
              <span class="status-icon"><i class="fas fa-check-circle"></i></span>
              <strong>Availability</strong>
              <span>Open to opportunities</span>
            </div>
          </div>

          <div class="contact-action mt-lg">
            <a href="mailto:arehman.dev@proton.me" class="btn btn-secondary w-full justify-center email-btn" id="email-me-btn">
              <i class="fas fa-paper-plane"></i> Email Me Directly
            </a>
          </div>

          <div class="socials-container mt-lg">
            <p class="socials-header">Connect across networks</p>
            <div class="socials-links-grid">
              <a href="https://github.com/arehman-dev" target="_blank" rel="noopener" class="social-link-btn flex align-center gap-md">
                <i class="fab fa-github"></i> GitHub
              </a>
              <a href="https://linkedin.com/in/arehman-dev" target="_blank" rel="noopener" class="social-link-btn flex align-center gap-md">
                <i class="fab fa-linkedin"></i> LinkedIn
              </a>
              <a href="https://twitter.com/arehman_dev" target="_blank" rel="noopener" class="social-link-btn flex align-center gap-md">
                <i class="fab fa-x-twitter"></i> X (Twitter)
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hire-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  /* Two Column Layout */
  .hire-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 1023px) {
    .hire-layout {
      grid-template-columns: 1fr;
    }
  }

  /* Resume Column */
  .resume-card-container {
    padding: 1.5rem;
  }

  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .resume-header h3 {
    margin-bottom: 0;
  }

  .pdf-viewer-container {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background-color: var(--gray-50);
  }

  .pdf-iframe {
    display: block;
    border: none;
  }

  .mobile-pdf-notice {
    display: none;
    text-align: center;
    padding: 2rem 1rem;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .notice-icon {
    font-size: 3rem;
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .pdf-viewer-container {
      display: none;
    }

    .mobile-pdf-notice {
      display: flex;
    }
  }

  /* Contact Details Column */
  .contact-details-card {
    border-top: 4px solid var(--primary);
  }

  .intro-contact-text {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .info-block-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background-color: var(--primary-light);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  [data-theme="dark"] .info-icon {
    background-color: rgba(1, 172, 106, 0.1);
  }

  .info-details {
    display: flex;
    flex-direction: column;
  }

  .info-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  .info-value {
    font-weight: 600;
    color: var(--text-main);
  }

  .info-value a {
    color: inherit;
    transition: color var(--transition-speed);
  }

  .info-value a:hover {
    color: var(--primary);
  }

  /* Status Mini Cards */
  .status-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .status-card {
    background-color: var(--gray-50);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid var(--border-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  [data-theme="dark"] .status-card {
    background-color: #222;
  }

  .status-icon {
    font-size: 1.25rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .status-card strong {
    font-size: 0.85rem;
    margin-bottom: 0.2rem;
    color: var(--text-main);
  }

  .status-card span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Email CTA Button */
  .email-btn {
    padding: 1rem;
    font-size: 1.05rem;
  }

  /* Social Links Bottom List */
  .socials-container {
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
  }

  .socials-header {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 1rem;
  }

  .socials-links-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-link-btn {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background-color: var(--gray-50);
    border: 1px solid var(--border-card);
    color: var(--text-main);
    font-weight: 500;
    transition: all var(--transition-speed);
  }

  [data-theme="dark"] .social-link-btn {
    background-color: #222;
  }

  .social-link-btn:hover {
    background-color: var(--primary-light);
    border-color: var(--primary);
    color: var(--primary);
  }

  [data-theme="dark"] .social-link-btn:hover {
    background-color: rgba(1, 172, 106, 0.1);
  }

  .social-link-btn i {
    font-size: 1.2rem;
  }
</style>
