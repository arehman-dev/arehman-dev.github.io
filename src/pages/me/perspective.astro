---
import PersonalLayout from '../../layouts/PersonalLayout.astro';
import { personalPosts } from '../../data/personal';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const meBase = `${base}me/`;

const perspectivePosts = personalPosts
  .filter((p) => p.category === 'perspective')
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const heroPost = perspectivePosts[0];
const remainingPosts = perspectivePosts.slice(1);
---

<PersonalLayout title="Perspective — Zawiya e Nazar">
  <span class="me-eyebrow">Zawiya e Nazar • <span class="urdu-inline">زاویہ نظر</span></span>
  <h1>Perspective</h1>

  <p>Welcome to my corner of the web. An ordinary man of calculated speech and deep thoughts.</p>
  <p><em>Essays where I use words to reflect on philosophy, systems thinking, ethics, and the quiet pursuit of excellence.</em></p>

  {heroPost && (
    <section class="category-hero-section">
      <h2>Latest Essay</h2>
      <a
        href={`${meBase}perspective/${heroPost.slug}/`}
        class={`content-card hero-spotlight-card ${heroPost.dir === 'rtl' ? 'urdu-text' : ''}`}
        data-category="perspective"
      >
        <span class="card-meta" style="font-family: 'Inter', sans-serif;">
          Spotlight • {heroPost.displayDate} • {heroPost.readTime}
        </span>
        <h3>{heroPost.title}</h3>
        <p style={heroPost.dir === 'ltr' ? "font-family: 'Lora', serif;" : undefined}>{heroPost.excerpt}</p>
        <div class="card-read-footer" style="font-family: 'Inter', sans-serif;">
          <span class={heroPost.dir === 'rtl' ? 'urdu-inline' : ''}>{heroPost.dir === 'rtl' ? 'مضمون پڑھیں ←' : 'Read full essay →'}</span>
          <div class="card-tags-inline">
            {heroPost.tags.slice(0, 3).map((t) => (
              <span class={`mini-tag ${/[\u0600-\u06FF]/.test(t) ? 'urdu-inline' : ''}`}><span class="hash-mark">#</span>{t}</span>
            ))}
          </div>
        </div>
      </a>
    </section>
  )}

  <h2>All Perspective Essays ({perspectivePosts.length})</h2>

  <div class="card-grid">
    {remainingPosts.map((post) => (
      <a
        href={`${meBase}perspective/${post.slug}/`}
        class={`content-card ${post.dir === 'rtl' ? 'urdu-text' : ''}`}
        data-category="perspective"
      >
        <span class="card-meta" style={post.dir === 'rtl' ? "text-align: right; font-family: 'Inter', sans-serif;" : undefined}>
          {post.displayDate} • {post.readTime}
        </span>
        <h3>{post.title}</h3>
        <p style={post.dir === 'ltr' ? "font-family: 'Lora', serif;" : undefined}>{post.excerpt}</p>
        <div class="card-read-footer" style="font-family: 'Inter', sans-serif;">
          <span class={post.dir === 'rtl' ? 'urdu-inline' : ''}>{post.dir === 'rtl' ? 'مطالعہ کریں ←' : 'Read essay →'}</span>
          <span class="card-date-chip">{post.shortDate}</span>
        </div>
      </a>
    ))}
  </div>
</PersonalLayout>
